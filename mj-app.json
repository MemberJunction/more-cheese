{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "more-cheese-demo",
  "displayName": "MoreCheese Demo",
  "description": "The MoreCheese demo open app \u2014 the fictional International Cheese Federation. Composes the BizApps open-app catalog with association-domain schemas (members, events, learning, forums, awards, legislative, marketing) to demonstrate MemberJunction against a realistic multi-system environment.",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-cheese",
  "color": "#E8A33D",
  "publisher": {
    "name": "Blue Cypress",
    "email": "marcelo.torres@bluecypress.io"
  },
  "repository": "https://github.com/BlueCypress/More-Cheese-Demo-V2",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "schema": {
    "name": "AssociationDemoV2_Members",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-more-cheese-demo/server",
        "role": "bootstrap",
        "startupExport": "LoadMoreCheeseDemoServer"
      }
    ],
    "client": [
      {
        "name": "@mj-more-cheese-demo/ng",
        "role": "bootstrap",
        "startupExport": "LoadMoreCheeseDemoClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-more-cheese-demo/entities",
        "role": "library"
      },
      {
        "name": "@mj-more-cheese-demo/actions",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "Demo"
  ],
  "tags": [
    "demo",
    "association",
    "morecheese",
    "international-cheese-federation"
  ]
}
