{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "more-cheese-demo",
  "displayName": "MoreCheese Demo",
  "description": "The MoreCheese demo association (International Cheese Federation): a generated, causally-consistent dataset demonstrating the MJ platform across composed BizApps.",
  "version": "1.0.0",
  "license": "<Set-this>",
  "icon": "fa-solid fa-cube",
  "color": "#264FAF",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/BlueCypress/More-Cheese-Demo-V2.git",
  "mjVersionRange": ">=5.0.0 <6.0.0",
  "schema": {
    "name": "morecheese_members",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-more-cheese-demo/server",
        "role": "bootstrap",
        "startupExport": "LoadSampleAppServer"
      }
    ],
    "client": [
      {
        "name": "@mj-more-cheese-demo/ng",
        "role": "bootstrap",
        "startupExport": "LoadSampleAppClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-more-cheese-demo/entities",
        "role": "library"
      },
      {
        "name": "@mj-more-cheese-demo/actions",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "Demo"
  ],
  "tags": [
    "demo",
    "association",
    "morecheese"
  ],
  "dependencies": [
    {
      "name": "mj-bizapps-common",
      "repository": "https://github.com/MemberJunction/bizapps-common",
      "versionRange": ">=5.30.0 <6.0.0"
    },
    {
      "name": "mj-committees",
      "repository": "https://github.com/MemberJunction/bizapps-committees",
      "versionRange": ">=1.0.0 <2.0.0"
    },
    {
      "name": "mj-bizapps-forms",
      "repository": "https://github.com/MemberJunction/bizapps-forms",
      "versionRange": ">=0.1.0 <1.0.0"
    }
  ]
}