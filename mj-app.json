{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "mj-sample-app",
  "displayName": "MJ Sample Open App (Template)",
  "description": "A fill-in-the-blanks template for building MemberJunction Open Apps. Clone it, rename it, and replace the samples with your app.",
  "version": "1.0.0",
  "license": "<Set-this>",
  "icon": "fa-solid fa-cube",
  "color": "#264FAF",
  "publisher": {
    "name": "MemberJunction",
    "email": "dev@memberjunction.com",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/BlueCypress/More-Cheese-Demo-V2.git",
  "mjVersionRange": ">=5.0.0 <6.0.0",
  "schema": {
    "name": "sample_app",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-more-cheese-demo/server",
        "role": "bootstrap",
        "startupExport": "LoadSampleAppServer"
      }
    ],
    "client": [
      {
        "name": "@mj-more-cheese-demo/ng",
        "role": "bootstrap",
        "startupExport": "LoadSampleAppClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-more-cheese-demo/entities",
        "role": "library"
      },
      {
        "name": "@mj-more-cheese-demo/actions",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": ["Template"],
  "tags": ["template", "sample", "starter"]
}
