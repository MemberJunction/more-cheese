{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "more-cheese-demo",
  "displayName": "MoreCheese Demo",
  "description": "The MoreCheese demo association (International Cheese Federation): a generated, causally-consistent dataset demonstrating the MJ platform across composed BizApps.",
  "version": "1.0.0",
  "license": "ISC",
  "icon": "fa-solid fa-cheese",
  "color": "#E8A33D",
  "publisher": {
    "name": "Blue Cypress",
    "email": "marcelo.torres@bluecypress.io"
  },
  "repository": "https://github.com/BlueCypress/More-Cheese-Demo-V2",
  "mjVersionRange": ">=5.43.0 <6.0.0",
  "schema": {
    "name": "morecheese_members",
    "createIfNotExists": true,
    "entityPackage": "@mj-more-cheese-demo/entities"
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "dependencies": {
    "mj-bizapps-common": {
      "version": ">=5.30.0 <6.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-common"
    },
    "mj-committees": {
      "version": ">=1.0.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-committees"
    },
    "mj-bizapps-forms": {
      "version": ">=0.1.0 <1.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-forms"
    },
    "mj-bizapps-tasks": {
      "version": ">=1.0.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-tasks"
    },
    "mj-bizapps-issues": {
      "version": ">=1.0.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-issues"
    },
    "mj-secure-messaging": {
      "version": ">=1.0.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-secure-messaging"
    }
  },
  "packages": {
    "server": [
      {
        "name": "@mj-more-cheese-demo/server",
        "role": "bootstrap",
        "startupExport": "LoadMoreCheeseDemoServer"
      }
    ],
    "client": [
      {
        "name": "@mj-more-cheese-demo/ng",
        "role": "bootstrap",
        "startupExport": "LoadMoreCheeseDemoClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-more-cheese-demo/entities",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "Demo"
  ],
  "tags": [
    "demo",
    "association",
    "morecheese",
    "international-cheese-federation"
  ]
}
