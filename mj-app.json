{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "more-cheese-demo",
  "displayName": "MoreCheese Demo",
  "description": "The MoreCheese demo association (International Cheese Federation): a generated, causally-consistent dataset demonstrating the MJ platform across composed BizApps.",
  "version": "1.2.1",
  "license": "MIT",
  "icon": "fa-solid fa-cheese",
  "color": "#E8A33D",
  "publisher": {
    "name": "Blue Cypress",
    "email": "marcelo.torres@bluecypress.io"
  },
  "repository": "https://github.com/MemberJunction/more-cheese",
  "mjVersionRange": ">=6.1.2 <7.0.0",
  "schema": {
    "name": "morecheese_members",
    "createIfNotExists": true,
    "entityPackage": "@mj-biz-apps/more-cheese-entities"
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway",
    "teardownDirectory": "migrations-teardown"
  },
  "metadata": {
    "directory": "generated"
  },
  "dependencies": {
    "mj-bizapps-common": {
      "version": ">=5.45.0 <6.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-common"
    },
    "mj-bizapps-orders": {
      "version": ">=5.0.0 <6.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-orders"
    },
    "mj-bizapps-accounting": {
      "version": ">=0.4.0 <1.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-accounting"
    },
    "mj-committees": {
      "version": ">=1.3.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-committees"
    },
    "mj-bizapps-forms": {
      "version": ">=0.1.0 <1.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-forms"
    },
    "mj-bizapps-tasks": {
      "version": ">=1.0.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-tasks"
    },
    "mj-bizapps-issues": {
      "version": ">=1.0.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-issues"
    },
    "mj-secure-messaging": {
      "version": ">=2.0.0 <3.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-secure-messaging"
    },
    "mj-bizapps-sonar": {
      "version": ">=0.4.0 <1.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-sonar"
    },
    "skip-client": {
      "version": ">=0.3.0",
      "repository": "https://github.com/BlueCypress/Skip-Client-Open-App"
    }
  },
  "packages": {
    "server": [
      {
        "name": "@mj-biz-apps/more-cheese-server",
        "role": "bootstrap",
        "startupExport": "LoadMoreCheeseDemoServer"
      }
    ],
    "client": [
      {
        "name": "@mj-biz-apps/more-cheese-ng",
        "role": "bootstrap",
        "startupExport": "LoadMoreCheeseDemoClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-biz-apps/more-cheese-entities",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "Demo"
  ],
  "tags": [
    "demo",
    "association",
    "morecheese",
    "international-cheese-federation"
  ]
}
