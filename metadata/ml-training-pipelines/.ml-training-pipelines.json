    "fields": {
      "Name": "MoreCheese: Member Renewal Risk",
      "Description": "Predicts whether a More Cheese member renews or lapses. Trained on the live 'MoreCheese: Member Renewal Signals' view: the label (RenewalOutcome) is 'Lapsed' when the member's latest membership-dues order is more than 395 days older than the dataset's reference date, and every feature is computed as of that last membership purchase (tenure, prior terms, dues, store orders, events attended, courses). Scores land on each Member Profile (RenewalProbability / RenewalStatus / RenewalScoredAt). No dependency on Subscriptions or Journal Entries.",
      "Version": 1,
      "Status": "Published",
      "TargetEntityID": "@lookup:MJ: Entities.Name=MoreCheese: Member Renewal Signals",
      "TargetVariable": "RenewalOutcome",
      "ProblemType": "classification",
      "AlgorithmID": "@lookup:MJ: ML Algorithms.Name=LightGBM",
      "Hyperparameters": {},
      "SourceBindings": [
        {
          "Kind": "Entity",
          "Ref": "MoreCheese: Member Renewal Signals"
        }
      ],
      "FeatureSteps": {
