              "DuesAmount",
              "OrdersCount",
              "TotalOrderSpend",
              "DaysSinceLastOrder",
              "EventsAttendedCount",
              "DaysSinceLastEvent",
              "CoursesEnrolledCount",
              "CoursesCompletedCount"
            ]
          },
          {
