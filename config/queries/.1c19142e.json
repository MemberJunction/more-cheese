{
  "fields": {
    "Name": "Order Line Details By Product Category",
    "CategoryID": "A841A12C-2F66-48EB-B383-211D11D5A2C7",
    "Description": "Retrieves granular line item transaction records enriched with order header, customer identity, product, and product category metadata for drill-down analysis. Filters for confirmed/posted/fulfilled orders and excludes rollup parents.",
    "SQL": "SELECT\n    ol.ID AS OrderLineID,\n    oh.ID AS OrderHeaderID,\n    oh.OrderNumber,\n    oh.OrderDate,\n    COALESCE(\n        oh.BillToPerson,\n        oh.BillToOrganization,\n        'Anonymous'\n    ) AS CustomerName,\n    ol.ProductID,\n    p.Name AS ProductName,\n    pc.ID AS CategoryID,\n    pc.Name AS CategoryName,\n    ol.Quantity,\n    ol.UnitPrice,\n    ol.LineTotalNet,\n    ol.LineTotalGross,\n    COALESCE(ol.FulfillmentStatus, oh.FulfillmentStatus) AS FulfillmentStatus\nFROM\n    [__mj_BizAppsOrders].[vwOrderLines] ol\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON ol.OrderHeaderID = oh.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProducts] p ON ol.ProductID = p.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProductCategories] pc ON p.ProductCategoryID = pc.ID\nWHERE\n    oh.[Status] IN ('Confirmed', 'Posted', 'Fulfilled')\n    AND ol.IsRollupParent = 0 {% if CategoryIDs and CategoryIDs.length > 0 %}\n    AND pc.ID IN {{ CategoryIDs | sqlIn }} {% endif %} {% if CategoryName %}\n    AND pc.Name = {{ CategoryName | sqlString }} {% endif %} {% if StartDate %}\n    AND oh.OrderDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND oh.OrderDate <= {{ EndDate | sqlDate }} {% endif %}\nORDER BY\n    oh.OrderDate DESC,\n    ol.ID ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
