{
  "fields": {
    "Name": "Monthly Revenue and Order Summary",
    "CategoryID": "FD4C8862-E63F-4509-B702-62D345521487",
    "Description": "Aggregates revenue, payments, balances, and transaction counts by calendar month for a specified year. Excludes Draft and Voided orders. Returns exactly 12 rows (Jan-Dec).",
    "SQL": "WITH\n    Months AS (\n        SELECT\n            1 AS MonthNumber,\n            'Jan' AS MonthName\n        UNION ALL\n        SELECT\n            2,\n            'Feb'\n        UNION ALL\n        SELECT\n            3,\n            'Mar'\n        UNION ALL\n        SELECT\n            4,\n            'Apr'\n        UNION ALL\n        SELECT\n            5,\n            'May'\n        UNION ALL\n        SELECT\n            6,\n            'Jun'\n        UNION ALL\n        SELECT\n            7,\n            'Jul'\n        UNION ALL\n        SELECT\n            8,\n            'Aug'\n        UNION ALL\n        SELECT\n            9,\n            'Sep'\n        UNION ALL\n        SELECT\n            10,\n            'Oct'\n        UNION ALL\n        SELECT\n            11,\n            'Nov'\n        UNION ALL\n        SELECT\n            12,\n            'Dec'\n    ),\n    OrderStats AS (\n        SELECT\n            MONTH(OrderDate) AS MonthNumber,\n            SUM(TotalGross) AS TotalRevenue,\n            SUM(AmountPaid) AS TotalPaid,\n            SUM(Balance) AS TotalBalance,\n            COUNT(ID) AS OrderCount\n        FROM\n            [__mj_BizAppsOrders].[vwOrderHeaders]\n        WHERE\n            YEAR(OrderDate) = {{ Year | sqlNumber }}\n            AND [Status] NOT IN ('Draft', 'Voided')\n        GROUP BY\n            MONTH(OrderDate)\n    )\nSELECT\n    {{ Year | sqlNumber }} AS OrderYear,\n    m.MonthNumber,\n    m.MonthName,\n    ISNULL(s.TotalRevenue, 0) AS TotalRevenue,\n    ISNULL(s.TotalPaid, 0) AS TotalPaid,\n    ISNULL(s.TotalBalance, 0) AS TotalBalance,\n    ISNULL(s.OrderCount, 0) AS OrderCount\nFROM\n    Months m\n    LEFT JOIN OrderStats s ON m.MonthNumber = s.MonthNumber\nORDER BY\n    m.MonthNumber ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
