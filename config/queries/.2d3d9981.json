{
  "fields": {
    "Name": "Monthly Email Engagement Rates",
    "CategoryID": "271A5166-6C06-4DD5-96D3-0BB80BF1E8E6",
    "Description": "Aggregates monthly email engagement performance metrics (Sent, Delivered, Opened, Clicked) and calculates rates (Open, CTR, CTOR) for outbound emails.",
    "SQL": "SELECT\n    YEAR(a.StartedAt) AS YearNumber,\n    MONTH(a.StartedAt) AS MonthNumber,\n    DATENAME(MONTH, a.StartedAt) AS MonthName,\n    COUNT(a.ID) AS TotalSent,\n    COUNT(\n        CASE\n            WHEN a.[Status] = 'Completed'\n            AND (\n                a.Outcome IS NULL\n                OR a.Outcome != 'Bounced'\n            ) THEN 1\n        END\n    ) AS TotalDelivered,\n    COUNT(\n        CASE\n            WHEN a.Outcome IN ('Opened', 'Clicked')\n            OR JSON_VALUE(a.Details, '$.opened') = 'true' THEN 1\n        END\n    ) AS TotalOpened,\n    COUNT(\n        CASE\n            WHEN a.Outcome = 'Clicked'\n            OR JSON_VALUE(a.Details, '$.clicked') = 'true' THEN 1\n        END\n    ) AS TotalClicked,\n    CAST(\n        (\n            COUNT(\n                CASE\n                    WHEN a.Outcome IN ('Opened', 'Clicked')\n                    OR JSON_VALUE(a.Details, '$.opened') = 'true' THEN 1\n                END\n            ) * 100.0\n        ) / NULLIF(\n            COUNT(\n                CASE\n                    WHEN a.[Status] = 'Completed'\n                    AND (\n                        a.Outcome IS NULL\n                        OR a.Outcome != 'Bounced'\n                    ) THEN 1\n                END\n            ),\n            0\n        ) AS DECIMAL(5, 2)\n    ) AS OpenRate,\n    CAST(\n        (\n            COUNT(\n                CASE\n                    WHEN a.Outcome = 'Clicked'\n                    OR JSON_VALUE(a.Details, '$.clicked') = 'true' THEN 1\n                END\n            ) * 100.0\n        ) / NULLIF(\n            COUNT(\n                CASE\n                    WHEN a.[Status] = 'Completed'\n                    AND (\n                        a.Outcome IS NULL\n                        OR a.Outcome != 'Bounced'\n                    ) THEN 1\n                END\n            ),\n            0\n        ) AS DECIMAL(5, 2)\n    ) AS ClickThroughRate,\n    CAST(\n        (\n            COUNT(\n                CASE\n                    WHEN a.Outcome = 'Clicked'\n                    OR JSON_VALUE(a.Details, '$.clicked') = 'true' THEN 1\n                END\n            ) * 100.0\n        ) / NULLIF(\n            COUNT(\n                CASE\n                    WHEN a.Outcome IN ('Opened', 'Clicked')\n                    OR JSON_VALUE(a.Details, '$.opened') = 'true' THEN 1\n                END\n            ),\n            0\n        ) AS DECIMAL(5, 2)\n    ) AS ClickToOpenRate\nFROM\n    [__mj_BizAppsCommon].[vwActivities] a\n    INNER JOIN [__mj_BizAppsCommon].[vwActivityTypes] at ON a.ActivityTypeID = at.ID\nWHERE\n    at.Code = 'Email'\n    AND a.Direction = 'Outbound' {% if StartDate %}\n    AND a.StartedAt >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND a.StartedAt <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    YEAR(a.StartedAt),\n    MONTH(a.StartedAt),\n    DATENAME(MONTH, a.StartedAt)\nORDER BY\n    YearNumber,\n    MonthNumber",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
