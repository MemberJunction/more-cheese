{
  "fields": {
    "Name": "Member Counts By Committee",
    "CategoryID": "4EB7ECFB-BAF4-4CD3-B054-FAF3CDEFBC04",
    "Description": "Aggregates member counts per committee/chapter across active and historical membership periods, including total, active, and officer counts. Filterable by committee status and type.",
    "SQL": "SELECT\n    c.ID AS CommitteeID,\n    c.Name AS CommitteeName,\n    c.[Type] AS CommitteeType,\n    c.[Status] AS CommitteeStatus,\n    c.MissionStatement,\n    COUNT(DISTINCT m.PersonID) AS TotalMembers,\n    COUNT(\n        DISTINCT CASE\n            WHEN m.[Status] = 'Active' THEN m.PersonID\n        END\n    ) AS ActiveMembers,\n    COUNT(\n        DISTINCT CASE\n            WHEN m.[Status] = 'Active'\n            AND r.IsOfficer = 1 THEN m.PersonID\n        END\n    ) AS OfficerCount\nFROM\n    [__mj_BizAppsCommittees].[vwCommittees] c\n    LEFT JOIN [__mj_BizAppsCommittees].[vwTerms] t ON c.ID = t.CommitteeID\n    LEFT JOIN [__mj_BizAppsCommittees].[vwMemberships] m ON t.ID = m.TermID\n    LEFT JOIN [__mj_BizAppsCommittees].[vwRoles] r ON m.RoleID = r.ID\nWHERE\n    1 = 1 {% if CommitteeStatus %}\n    AND c.[Status] = {{ CommitteeStatus | sqlString }} {% endif %} {% if CommitteeType %}\n    AND c.[Type] = {{ CommitteeType | sqlString }} {% endif %}\nGROUP BY\n    c.ID,\n    c.Name,\n    c.[Type],\n    c.[Status],\n    c.MissionStatement\nORDER BY\n    ActiveMembers DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
