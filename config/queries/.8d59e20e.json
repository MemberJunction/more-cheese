{
  "fields": {
    "Name": "Member Engagement Leaderboard (1)",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Calculates member engagement by aggregating event attendance, course enrollments/completions, and committee terms across the federation. Ranks active members based on a composite engagement score.",
    "SQL": "WITH\n    EventMetrics AS (\n        SELECT\n            PersonID,\n            COUNT(\n                CASE\n                    WHEN Attended = 1 THEN 1\n                END\n            ) AS EventsAttended\n        FROM\n            [morecheese_events].[vwEventRegistrations]\n        GROUP BY\n            PersonID\n    ),\n    CourseMetrics AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS CoursesEnrolled,\n            COUNT(\n                CASE\n                    WHEN [Status] = 'Completed' THEN 1\n                END\n            ) AS CoursesCompleted\n        FROM\n            [morecheese_learning].[vwCourseEnrollments]\n        GROUP BY\n            PersonID\n    ),\n    CommitteeMetrics AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS CommitteeTerms\n        FROM\n            [__mj_BizAppsCommittees].[vwMemberships]\n        GROUP BY\n            PersonID\n    ),\n    MemberBase AS (\n        SELECT\n            p.ID AS PersonID,\n            mp.ID AS MemberProfileID,\n            mp.MemberNumber,\n            p.DisplayName AS MemberName,\n            p.CurrentOrganizationName,\n            mp.Segment,\n            mp.Region,\n            COALESCE(em.EventsAttended, 0) AS EventsAttended,\n            COALESCE(cm.CoursesEnrolled, 0) AS CoursesEnrolled,\n            COALESCE(cm.CoursesCompleted, 0) AS CoursesCompleted,\n            COALESCE(com.CommitteeTerms, 0) AS CommitteeTerms\n        FROM\n            [__mj_BizAppsCommon].[vwPeople] p\n            INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON p.ID = mp.PersonID\n            LEFT JOIN EventMetrics em ON p.ID = em.PersonID\n            LEFT JOIN CourseMetrics cm ON p.ID = cm.PersonID\n            LEFT JOIN CommitteeMetrics com ON p.ID = com.PersonID\n        WHERE\n            p.[Status] = 'Active' {% if Segment %}\n            AND mp.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n            AND mp.Region = {{ Region | sqlString }} {% endif %}\n    ),\n    ScoredMembers AS (\n        SELECT\n            *,\n            (EventsAttended * 3) + (CoursesCompleted * 4) + ((CoursesEnrolled - CoursesCompleted) * 1) + (CommitteeTerms * 5) AS EngagementScore\n        FROM\n            MemberBase\n    )\nSELECT\n    PersonID,\n    MemberProfileID,\n    MemberNumber,\n    MemberName,\n    CurrentOrganizationName,\n    Segment,\n    Region,\n    EventsAttended,\n    CoursesEnrolled,\n    CoursesCompleted,\n    CommitteeTerms,\n    EngagementScore,\n    DENSE_RANK() OVER (\n        ORDER BY\n            EngagementScore DESC\n    ) AS [Rank]\nFROM\n    ScoredMembers\nWHERE\n    1 = 1 {% if MinScore %}\n    AND EngagementScore >= {{ MinScore | sqlNumber }} {% endif %}\nORDER BY\n    [Rank] ASC,\n    MemberName ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
