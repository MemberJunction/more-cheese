  "fields": {
    "Name": "Chapter Member Directory Details",
    "CategoryID": "4ACF3EC1-D97F-41D4-8E9C-A289EBF6E2DA",
    "Description": "Retrieves a flattened list of all chapter members including profile details and membership status. Defaults to filtering for committees with Type='Chapter'.",
    "SQL": "SELECT\n    m.ID AS MembershipID,\n    c.ID AS CommitteeID,\n    c.Name AS ChapterName,\n    p.ID AS PersonID,\n    p.DisplayName AS MemberName,\n    mp.MemberNumber,\n    mp.Segment,\n    mp.Region,\n    mp.City,\n    mp.State,\n    mp.JoinDate,\n    m.Status AS MembershipStatus\nFROM\n    [__mj_BizAppsCommittees].[vwCommittees] AS c\n    INNER JOIN [__mj_BizAppsCommittees].[vwTerms] AS t ON c.ID = t.CommitteeID\n    INNER JOIN [__mj_BizAppsCommittees].[vwMemberships] AS m ON t.ID = m.TermID\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] AS p ON m.PersonID = p.ID\n    INNER JOIN [morecheese_members].[vwMemberProfiles] AS mp ON p.ID = mp.PersonID\nWHERE\n    c.[Type] = {{ CommitteeType | sqlString }}",
