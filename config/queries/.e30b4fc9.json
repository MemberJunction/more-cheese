  "fields": {
    "Name": "Total Outstanding Receivables And Order Count",
    "CategoryID": "FB712356-61E4-4992-8712-41C91FCDE085",
    "Description": "Calculates the total outstanding receivables (sum of balance) and the count of orders for records with a balance greater than zero and a status of 'Confirmed' or 'Posted'. Supports optional filtering by due date range.",
