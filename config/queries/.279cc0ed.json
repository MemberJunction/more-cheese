{
  "fields": {
    "Name": "Member Count and Dues by Membership Tier",
    "CategoryID": "8D044066-1D85-43D2-BB24-10D2716F968F",
    "Description": "Aggregates active federation memberships by MembershipTier, calculating member counts and dues statistics (Total, Avg, Min, Max).",
    "SQL": "SELECT\n    [MembershipTier],\n    COUNT(DISTINCT [PersonID]) AS [ActiveMemberCount],\n    SUM([DuesAmount]) AS [TotalDues],\n    AVG([DuesAmount]) AS [AvgDues],\n    MIN([DuesAmount]) AS [MinDues],\n    MAX([DuesAmount]) AS [MaxDues]\nFROM\n    [morecheese_members].[vwMembershipPeriods]\nWHERE\n    [Status] = {{ Status | sqlString }} {% if MembershipTiers and MembershipTiers.length > 0 %}\n    AND [MembershipTier] IN {{ MembershipTiers | sqlIn }} {% endif %}\nGROUP BY\n    [MembershipTier]\nORDER BY\n    [ActiveMemberCount] DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
