{
  "fields": {
    "Name": "Monthly Course Enrollment and Completion Trends",
    "CategoryID": "44D30D65-E0DC-4F70-984E-06E5041756F0",
    "Description": "Aggregates monthly enrollment volumes and completion metrics from MoreCheese: Course Enrollments. Groups by calendar year and month of EnrolledOn. Calculates TotalEnrollments, CompletedCount, InProgressCount, DroppedCount, and CompletionRate.",
    "SQL": "SELECT\n    YEAR(EnrolledOn) AS EnrollmentYear,\n    MONTH(EnrolledOn) AS EnrollmentMonth,\n    FORMAT(EnrolledOn, 'yyyy-MM') AS YearMonth,\n    COUNT(*) AS TotalEnrollments,\n    SUM(\n        CASE\n            WHEN [Status] = 'Completed' THEN 1\n            ELSE 0\n        END\n    ) AS CompletedCount,\n    SUM(\n        CASE\n            WHEN [Status] = 'InProgress' THEN 1\n            ELSE 0\n        END\n    ) AS InProgressCount,\n    SUM(\n        CASE\n            WHEN [Status] = 'Dropped' THEN 1\n            ELSE 0\n        END\n    ) AS DroppedCount,\n    CAST(\n        SUM(\n            CASE\n                WHEN [Status] = 'Completed' THEN 1\n                ELSE 0\n            END\n        ) * 100.0 / NULLIF(COUNT(*), 0) AS DECIMAL(18, 2)\n    ) AS CompletionRate\nFROM\n    [morecheese_learning].[vwCourseEnrollments]\nWHERE\n    1 = 1 {% if StartDate %}\n    AND EnrolledOn >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND EnrolledOn <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    YEAR(EnrolledOn),\n    MONTH(EnrolledOn),\n    FORMAT(EnrolledOn, 'yyyy-MM')\nORDER BY\n    EnrollmentYear,\n    EnrollmentMonth",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
