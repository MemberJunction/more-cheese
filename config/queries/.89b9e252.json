{
  "fields": {
    "Name": "Member Lifetime Value by Cohort Year",
    "CategoryID": "45A22A65-F6BB-45E4-A692-7D66496A3511",
    "Description": "Calculates member lifetime value (LTV) and revenue performance aggregated by member join year cohort, with optional segment and region filters.",
    "SQL": "SELECT\n    YEAR(m.JoinDate) AS CohortYear,\n    COUNT(DISTINCT m.ID) AS MemberCount,\n    SUM(ol.LineTotalGross) AS TotalRevenue,\n    COUNT(DISTINCT oh.ID) AS TotalOrders,\n    CAST(\n        SUM(ol.LineTotalGross) * 1.0 / NULLIF(COUNT(DISTINCT m.ID), 0) AS DECIMAL(18, 2)\n    ) AS AvgLTV\nFROM\n    [morecheese_members].[vwMemberProfiles] m\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON m.PersonID = p.ID\n    LEFT JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON oh.BillToPersonID = p.ID\n    AND oh.OrderType = 'Sale'\n    AND oh.Status IN ('Confirmed', 'Posted', 'Fulfilled')\n    LEFT JOIN [__mj_BizAppsOrders].[vwOrderLines] ol ON ol.OrderHeaderID = oh.ID\n    AND ol.IsRollupParent = 0\nWHERE\n    1 = 1 {% if Segment %}\n    AND m.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n    AND m.Region = {{ Region | sqlString }} {% endif %}\nGROUP BY\n    YEAR(m.JoinDate)\nORDER BY\n    CohortYear ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
