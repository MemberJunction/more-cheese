{
  "fields": {
    "Name": "Revenue and YoY Growth By Membership Tier",
    "CategoryID": "16DC714B-8648-47B7-94D4-481CF18195AE",
    "Description": "Calculates aggregated gross revenue per membership tier for the current and prior fiscal periods, along with YoY Growth percentage, transaction counts, and active member counts.",
    "SQL": "WITH\n    TierMetrics AS (\n        SELECT\n            mp.MembershipTier,\n            SUM(\n                CASE\n                    WHEN oh.OrderDate >= {{ CurrentYearStart | sqlDate }}\n                    AND oh.OrderDate <= {{ CurrentYearEnd | sqlDate }} THEN ol.LineTotalGross\n                    ELSE 0\n                END\n            ) AS CurrentPeriodRevenue,\n            SUM(\n                CASE\n                    WHEN oh.OrderDate >= {{ PriorYearStart | sqlDate }}\n                    AND oh.OrderDate <= {{ PriorYearEnd | sqlDate }} THEN ol.LineTotalGross\n                    ELSE 0\n                END\n            ) AS PriorPeriodRevenue,\n            COUNT(\n                DISTINCT CASE\n                    WHEN (\n                        oh.OrderDate >= {{ CurrentYearStart | sqlDate }}\n                        AND oh.OrderDate <= {{ CurrentYearEnd | sqlDate }}\n                    )\n                    OR (\n                        oh.OrderDate >= {{ PriorYearStart | sqlDate }}\n                        AND oh.OrderDate <= {{ PriorYearEnd | sqlDate }}\n                    ) THEN oh.ID\n                    ELSE NULL\n                END\n            ) AS TotalTransactions,\n            COUNT(DISTINCT mp.PersonID) AS ActiveMemberCount\n        FROM\n            [morecheese_members].[vwMembershipPeriods] mp\n            INNER JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON mp.PersonID = oh.BillToPersonID\n            AND oh.OrderDate >= mp.StartDate\n            AND oh.OrderDate <= mp.EndDate\n            INNER JOIN [__mj_BizAppsOrders].[vwOrderLines] ol ON oh.ID = ol.OrderHeaderID\n        WHERE\n            oh.[Status] = 'Confirmed'\n        GROUP BY\n            mp.MembershipTier\n    )\nSELECT\n    MembershipTier,\n    CurrentPeriodRevenue,\n    PriorPeriodRevenue,\n    CASE\n        WHEN PriorPeriodRevenue > 0 THEN (\n            (CurrentPeriodRevenue - PriorPeriodRevenue) / PriorPeriodRevenue\n        ) * 100.0\n        ELSE NULL\n    END AS YoYGrowthPct,\n    TotalTransactions,\n    ActiveMemberCount\nFROM\n    TierMetrics",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
