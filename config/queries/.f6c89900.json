{
  "fields": {
    "Name": "Top Courses by Total Enrollments",
    "CategoryID": "3B8652CB-E248-4D99-B32F-8E70B858CF03",
    "Description": "Aggregates total enrollment volume per course across the entire catalog and ranks courses by popularity. Supports limiting to top results and filtering by course start date.",
    "SQL": "SELECT\n    {% if TopN %} TOP ({{ TopN | sqlNumber }}) {% endif %} c.ID AS CourseID,\n    c.CourseKey,\n    c.[Name] AS CourseName,\n    c.StartDate,\n    c.DurationWeeks,\n    COUNT(ce.ID) AS TotalEnrollments\nFROM\n    [morecheese_learning].[vwCourses] AS c\n    LEFT JOIN [morecheese_learning].[vwCourseEnrollments] AS ce ON c.ID = ce.CourseID\nWHERE\n    1 = 1 {% if StartDateFrom %}\n    AND c.StartDate >= {{ StartDateFrom | sqlDate }} {% endif %} {% if StartDateTo %}\n    AND c.StartDate <= {{ StartDateTo | sqlDate }} {% endif %}\nGROUP BY\n    c.ID,\n    c.CourseKey,\n    c.[Name],\n    c.StartDate,\n    c.DurationWeeks\nORDER BY\n    TotalEnrollments DESC,\n    CourseName ASC",
    "Status": "Pending",
