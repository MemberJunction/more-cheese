{
  "fields": {
    "Name": "Committee Member Roster Details",
    "CategoryID": "C7503D04-6A4E-4F76-B0D9-FE7A0BF84BFD",
    "Description": "Retrieves the complete flattened member roster across all chapters and committees with demographic, organizational, and contact details. Supports filtering by committee type, membership status, and member segment.",
    "SQL": "SELECT\n    m.ID AS MembershipID,\n    c.ID AS CommitteeID,\n    c.Name AS CommitteeName,\n    c.Type AS CommitteeType,\n    p.ID AS PersonID,\n    p.DisplayName AS MemberName,\n    p.Email AS Email,\n    mp.MemberNumber AS MemberNumber,\n    r.ID AS RoleID,\n    r.Name AS RoleName,\n    r.IsOfficer AS IsOfficer,\n    r.IsVotingRole AS IsVotingRole,\n    mp.Segment AS Segment,\n    mp.Organization AS OrganizationName,\n    mp.City AS City,\n    mp.State AS State,\n    mp.Country AS Country,\n    mp.CountryName AS CountryName,\n    COALESCE(\n        mp.City + ', ' + mp.State + ' (' + mp.Country + ')',\n        mp.City + ', ' + mp.CountryName,\n        mp.CountryName\n    ) AS Location,\n    t.ID AS TermID,\n    t.Name AS TermName,\n    t.Status AS TermStatus,\n    m.Status AS MembershipStatus,\n    m.StartDate AS StartDate,\n    m.EndDate AS EndDate,\n    m.RenewalIntent AS RenewalIntent\nFROM\n    [__mj_BizAppsCommittees].[vwMemberships] m\n    INNER JOIN [__mj_BizAppsCommittees].[vwTerms] t ON m.TermID = t.ID\n    INNER JOIN [__mj_BizAppsCommittees].[vwCommittees] c ON t.CommitteeID = c.ID\n    INNER JOIN [__mj_BizAppsCommittees].[vwRoles] r ON m.RoleID = r.ID\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON m.PersonID = p.ID\n    INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON m.PersonID = mp.PersonID\nWHERE\n    1 = 1 {% if CommitteeTypes and CommitteeTypes.length > 0 %}\n    AND c.Type IN {{ CommitteeTypes | sqlIn }} {% endif %} {% if MembershipStatuses and MembershipStatuses.length > 0 %}\n    AND m.Status IN {{ MembershipStatuses | sqlIn }} {% endif %} {% if Segments and Segments.length > 0 %}\n    AND mp.Segment IN {{ Segments | sqlIn }} {% endif %}\nORDER BY\n    c.Name ASC,\n    r.Sequence ASC,\n    p.LastName ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
