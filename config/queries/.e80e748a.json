{
  "fields": {
    "Name": "Quarterly Course Completion Rates",
    "CategoryID": "972753F6-0627-41DB-8A68-1B829F8DF53C",
    "Description": "Aggregates quarterly cohort completion trends for courses over time, with optional filters for specific courses and date ranges.",
    "SQL": "SELECT\n    ce.CourseID,\n    c.Name AS CourseName,\n    DATEPART(year, ce.EnrolledOn) AS EnrollmentYear,\n    DATEPART(quarter, ce.EnrolledOn) AS EnrollmentQuarter,\n    CONCAT(\n        CAST(DATEPART(year, ce.EnrolledOn) AS VARCHAR(4)),\n        '-Q',\n        CAST(DATEPART(quarter, ce.EnrolledOn) AS VARCHAR(1))\n    ) AS QuarterLabel,\n    COUNT(*) AS TotalEnrolled,\n    SUM(\n        CASE\n            WHEN ce.Status = 'Completed' THEN 1\n            ELSE 0\n        END\n    ) AS CompletedCount,\n    SUM(\n        CASE\n            WHEN ce.Status = 'InProgress' THEN 1\n            ELSE 0\n        END\n    ) AS InProgressCount,\n    SUM(\n        CASE\n            WHEN ce.Status = 'Dropped' THEN 1\n            ELSE 0\n        END\n    ) AS DroppedCount,\n    (\n        SUM(\n            CASE\n                WHEN ce.Status = 'Completed' THEN 1.0\n                ELSE 0.0\n            END\n        ) * 100.0\n    ) / NULLIF(COUNT(*), 0) AS CompletionRate\nFROM\n    [morecheese_learning].[vwCourseEnrollments] ce\n    INNER JOIN [morecheese_learning].[vwCourses] c ON ce.CourseID = c.ID\nWHERE\n    1 = 1 {% if CourseIDs and CourseIDs.length > 0 %}\n    AND ce.CourseID IN {{ CourseIDs | sqlIn }} {% endif %} {% if StartDate %}\n    AND ce.EnrolledOn >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND ce.EnrolledOn <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    ce.CourseID,\n    c.Name,\n    DATEPART(year, ce.EnrolledOn),\n    DATEPART(quarter, ce.EnrolledOn)\nORDER BY\n    EnrollmentYear ASC,\n    EnrollmentQuarter ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
