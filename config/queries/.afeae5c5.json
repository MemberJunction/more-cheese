{
  "fields": {
    "Name": "Membership Count and Revenue by Tier",
    "CategoryID": "8D044066-1D85-43D2-BB24-10D2716F968F",
    "Description": "Aggregates active membership counts and annualized dues revenue (ARR) grouped by MembershipTier. Calculates total distinct active members, total annualized revenue, average dues per member, and percentage distribution.",
    "SQL": "WITH\n    TierStats AS (\n        SELECT\n            [MembershipTier],\n            COUNT(DISTINCT [PersonID]) AS [MemberCount],\n            SUM([DuesAmount]) AS [TotalARR],\n            AVG([DuesAmount]) AS [AvgDues]\n        FROM\n            [morecheese_members].[vwMembershipPeriods]\n        WHERE\n            [Status] = {{ Status | sqlString }} {% if MembershipTiers and MembershipTiers.length > 0 %}\n            AND [MembershipTier] IN {{ MembershipTiers | sqlIn }} {% endif %}\n        GROUP BY\n            [MembershipTier]\n    ),\n    TotalStats AS (\n        SELECT\n            SUM([MemberCount]) AS [GrandTotalMembers]\n        FROM\n            TierStats\n    )\nSELECT\n    ts.[MembershipTier],\n    ts.[MemberCount],\n    ts.[TotalARR],\n    ts.[AvgDues],\n    CAST(\n        ts.[MemberCount] * 100.0 / NULLIF(tot.[GrandTotalMembers], 0) AS DECIMAL(18, 2)\n    ) AS [PercentageShare]\nFROM\n    TierStats ts\n    CROSS JOIN TotalStats tot\nORDER BY\n    ts.[MemberCount] DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
