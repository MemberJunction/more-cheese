{
  "fields": {
    "Name": "Event Attendance And Show Rate By Event",
    "CategoryID": "28BA117D-4EA3-4F21-9247-EEDB8EE66E2F",
    "Description": "Calculates attendance metrics per event, including total registrations, actual attendees, and the show rate percentage. Supports filtering by event type and date range.",
    "SQL": "SELECT\n    e.ID AS EventID,\n    e.Name AS EventName,\n    e.EventType,\n    e.EventDate,\n    COUNT(er.ID) AS TotalRegistrations,\n    SUM(\n        CASE\n            WHEN er.Attended = 1 THEN 1\n            ELSE 0\n        END\n    ) AS TotalAttendees,\n    CAST(\n        SUM(\n            CASE\n                WHEN er.Attended = 1 THEN 1\n                ELSE 0\n            END\n        ) * 100.0 / NULLIF(COUNT(er.ID), 0) AS DECIMAL(5, 2)\n    ) AS ShowRate\nFROM\n    [morecheese_events].[vwEvents] e\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON e.ID = er.EventID\nWHERE\n    1 = 1 {% if EventType %}\n    AND e.EventType = {{ EventType | sqlString }} {% endif %} {% if StartDate %}\n    AND e.EventDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND e.EventDate <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    e.ID,\n    e.Name,\n    e.EventType,\n    e.EventDate\nORDER BY\n    e.EventDate DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
