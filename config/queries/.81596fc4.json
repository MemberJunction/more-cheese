{
  "fields": {
    "Name": "Committee Membership Distribution",
    "CategoryID": "4EB7ECFB-BAF4-4CD3-B054-FAF3CDEFBC04",
    "Description": "Calculates member seat distribution across all committees and chapters, including active and total member counts and active term counts. Filters out dissolved committees.",
    "SQL": "SELECT\n    c.ID AS CommitteeID,\n    c.Name AS CommitteeName,\n    c.Type AS CommitteeType,\n    COUNT(\n        DISTINCT CASE\n            WHEN m.Status = 'Active' THEN m.ID\n        END\n    ) AS ActiveMemberCount,\n    COUNT(DISTINCT m.ID) AS TotalMemberCount,\n    COUNT(\n        DISTINCT CASE\n            WHEN t.Status = 'Active' THEN t.ID\n        END\n    ) AS ActiveTermCount\nFROM\n    [__mj_BizAppsCommittees].[vwCommittees] c\n    LEFT JOIN [__mj_BizAppsCommittees].[vwTerms] t ON c.ID = t.CommitteeID\n    LEFT JOIN [__mj_BizAppsCommittees].[vwMemberships] m ON t.ID = m.TermID\nWHERE\n    c.Status <> 'Dissolved' {% if CommitteeTypes and CommitteeTypes.length > 0 %}\n    AND c.Type IN {{ CommitteeTypes | sqlIn }} {% endif %} {% if CommitteeStatus %}\n    AND c.Status = {{ CommitteeStatus | sqlString }} {% endif %}\nGROUP BY\n    c.ID,\n    c.Name,\n    c.Type\nORDER BY\n    ActiveMemberCount DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
