{
  "fields": {
    "Name": "Quarterly Event Attendance Trends",
    "CategoryID": "28BA117D-4EA3-4F21-9247-EEDB8EE66E2F",
    "Description": "Aggregates event attendance and registration volume by calendar year and quarter. Calculates distinct event counts, total registrations, total attendees, and attendance rates.",
    "SQL": "SELECT\n    YEAR(e.EventDate) AS [Year],\n    DATEPART(QUARTER, e.EventDate) AS [Quarter],\n    CONCAT(\n        YEAR(e.EventDate),\n        ' Q',\n        DATEPART(QUARTER, e.EventDate)\n    ) AS QuarterLabel,\n    COUNT(DISTINCT e.ID) AS DistinctEvents,\n    COUNT(er.ID) AS TotalRegistrations,\n    COUNT(\n        CASE\n            WHEN er.Attended = 1 THEN 1\n        END\n    ) AS TotalAttendees,\n    CAST(\n        COUNT(\n            CASE\n                WHEN er.Attended = 1 THEN 1\n            END\n        ) * 100.0 / NULLIF(COUNT(er.ID), 0) AS DECIMAL(5, 2)\n    ) AS AttendanceRate\nFROM\n    [morecheese_events].[vwEvents] e\n    INNER JOIN [morecheese_events].[vwEventRegistrations] er ON e.ID = er.EventID\nWHERE\n    1 = 1 {% if StartDate %}\n    AND e.EventDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND e.EventDate <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    YEAR(e.EventDate),\n    DATEPART(QUARTER, e.EventDate)\nORDER BY\n    [Year] ASC,\n    [Quarter] ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
