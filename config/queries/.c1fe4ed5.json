{
  "fields": {
    "Name": "Member Engagement and Activity Analysis",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Aggregates member-level engagement attributes across events and courses, calculating tiers and a weighted engagement score based on attendance, completions, and tenure.",
    "SQL": "WITH\n    EventStats AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS TotalEvents,\n            SUM(\n                CASE\n                    WHEN Attended = 1 THEN 1\n                    ELSE 0\n                END\n            ) AS EventsAttended\n        FROM\n            [morecheese_events].[vwEventRegistrations]\n        GROUP BY\n            PersonID\n    ),\n    CourseStats AS (\n        SELECT\n            PersonID,\n            SUM(\n                CASE\n                    WHEN [Status] = 'Completed' THEN 1\n                    ELSE 0\n                END\n            ) AS CompletedCourses,\n            SUM(\n                CASE\n                    WHEN [Status] = 'InProgress' THEN 1\n                    ELSE 0\n                END\n            ) AS InProgressCourses,\n            COUNT(*) AS TotalCourses\n        FROM\n            [morecheese_learning].[vwCourseEnrollments]\n        GROUP BY\n            PersonID\n    )\nSELECT\n    mp.ID AS MemberProfileID,\n    mp.PersonID,\n    mp.OrganizationID,\n    mp.MemberNumber,\n    p.DisplayName AS MemberName,\n    p.Email,\n    o.[Name] AS OrganizationName,\n    mp.Segment,\n    mp.Region,\n    mp.State,\n    mp.City,\n    mp.JoinDate,\n    ISNULL(es.TotalEvents, 0) AS TotalEvents,\n    ISNULL(es.EventsAttended, 0) AS EventsAttended,\n    CASE\n        WHEN ISNULL(es.TotalEvents, 0) >= 5 THEN 'High (5+ Events)'\n        WHEN ISNULL(es.TotalEvents, 0) BETWEEN 2 AND 4  THEN 'Medium (2-4 Events)'\n        WHEN ISNULL(es.TotalEvents, 0) = 1 THEN 'Low (1 Event)'\n        ELSE 'None (0 Events)'\n    END AS EventTier,\n    ISNULL(cs.CompletedCourses, 0) AS CompletedCourses,\n    ISNULL(cs.InProgressCourses, 0) AS InProgressCourses,\n    ISNULL(cs.TotalCourses, 0) AS TotalCourses,\n    CASE\n        WHEN ISNULL(cs.CompletedCourses, 0) >= 3 THEN 'Completed 3+ Courses'\n        WHEN ISNULL(cs.CompletedCourses, 0) BETWEEN 1 AND 2  THEN 'Completed 1-2 Courses'\n        WHEN ISNULL(cs.CompletedCourses, 0) = 0\n        AND ISNULL(cs.InProgressCourses, 0) > 0 THEN 'Enrolled / In Progress'\n        ELSE 'No Courses'\n    END AS CourseTier,\n    CAST(\n        CASE\n            WHEN (\n                (\n                    CASE\n                        WHEN ISNULL(es.EventsAttended, 0) * 8 > 40 THEN 40\n                        ELSE ISNULL(es.EventsAttended, 0) * 8\n                    END\n                ) + (\n                    CASE\n                        WHEN ISNULL(cs.CompletedCourses, 0) * 10 > 40 THEN 40\n                        ELSE ISNULL(cs.CompletedCourses, 0) * 10\n                    END\n                ) + (\n                    CASE\n                        WHEN DATEDIFF(year, mp.JoinDate, GETUTCDATE()) * 4 > 20 THEN 20\n                        ELSE DATEDIFF(year, mp.JoinDate, GETUTCDATE()) * 4\n                    END\n                )\n            ) > 100 THEN 100\n            ELSE (\n                (\n                    CASE\n                        WHEN ISNULL(es.EventsAttended, 0) * 8 > 40 THEN 40\n                        ELSE ISNULL(es.EventsAttended, 0) * 8\n                    END\n                ) + (\n                    CASE\n                        WHEN ISNULL(cs.CompletedCourses, 0) * 10 > 40 THEN 40\n                        ELSE ISNULL(cs.CompletedCourses, 0) * 10\n                    END\n                ) + (\n                    CASE\n                        WHEN DATEDIFF(year, mp.JoinDate, GETUTCDATE()) * 4 > 20 THEN 20\n                        ELSE DATEDIFF(year, mp.JoinDate, GETUTCDATE()) * 4\n                    END\n                )\n            )\n        END AS INT\n    ) AS EngagementScore\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mp.PersonID = p.ID\n    LEFT JOIN [__mj_BizAppsCommon].[vwOrganizations] o ON mp.OrganizationID = o.ID\n    LEFT JOIN EventStats es ON mp.PersonID = es.PersonID\n    LEFT JOIN CourseStats cs ON mp.PersonID = cs.PersonID\nWHERE\n    1 = 1 {% if Segments and Segments.length > 0 %}\n    AND mp.Segment IN {{ Segments | sqlIn }} {% endif %} {% if Regions and Regions.length > 0 %}\n    AND mp.Region IN {{ Regions | sqlIn }} {% endif %} {% if JoinDateStart %}\n    AND mp.JoinDate >= {{ JoinDateStart | sqlDate }} {% endif %}\nORDER BY\n    InProgressCourses DESC",
    "Status": "Pending",
