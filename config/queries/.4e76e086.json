{
  "fields": {
    "Name": "Member Engagement Leaderboard",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Calculates normalized 0–100 composite engagement scores and cohort rankings for all active members across 5 weighted dimensions (Events, Courses, Leadership, Committees, and Tenure). Supports optional filtering by Segment and Region.",
    "SQL": "WITH\n    EventsAgg AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS EventsAttendedCount\n        FROM\n            [morecheese_events].[vwEventRegistrations]\n        WHERE\n            Attended = 1\n        GROUP BY\n            PersonID\n    ),\n    CoursesAgg AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS CoursesCompletedCount\n        FROM\n            [morecheese_learning].[vwCourseEnrollments]\n        WHERE\n            [Status] = 'Completed'\n        GROUP BY\n            PersonID\n    ),\n    LeadershipAgg AS (\n        SELECT\n            FromPersonID AS PersonID,\n            COUNT(*) AS LeadershipRolesCount\n        FROM\n            [__mj_BizAppsCommon].[vwRelationships]\n        WHERE\n            [Status] = 'Active'\n        GROUP BY\n            FromPersonID\n    ),\n    CommitteesAgg AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS CommitteeTermsCount\n        FROM\n            [__mj_BizAppsCommittees].[vwMemberships]\n        GROUP BY\n            PersonID\n    ),\n    MemberBase AS (\n        SELECT\n            p.ID AS PersonID,\n            p.DisplayName,\n            mp.MemberNumber,\n            mp.Segment,\n            mp.Region,\n            mp.CountryName,\n            mp.City,\n            mp.JoinDate,\n            ISNULL(e.EventsAttendedCount, 0) AS EventsAttendedCount,\n            ISNULL(c.CoursesCompletedCount, 0) AS CoursesCompletedCount,\n            ISNULL(l.LeadershipRolesCount, 0) AS LeadershipRolesCount,\n            ISNULL(cm.CommitteeTermsCount, 0) AS CommitteeTermsCount,\n            CAST(\n                DATEDIFF(day, mp.JoinDate, GETDATE()) / 365.25 AS DECIMAL(10, 2)\n            ) AS TenureYears\n        FROM\n            [__mj_BizAppsCommon].[vwPeople] p\n            INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON p.ID = mp.PersonID\n            LEFT JOIN EventsAgg e ON p.ID = e.PersonID\n            LEFT JOIN CoursesAgg c ON p.ID = c.PersonID\n            LEFT JOIN LeadershipAgg l ON p.ID = l.PersonID\n            LEFT JOIN CommitteesAgg cm ON p.ID = cm.PersonID\n        WHERE\n            p.[Status] = 'Active' {% if Segment %}\n            AND mp.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n            AND mp.Region = {{ Region | sqlString }} {% endif %}\n    ),\n    ScoredMembers AS (\n        SELECT\n            *,\n            -- Events (30% max, min(EventsAttended * 2.5, 30.0))\n            CASE\n                WHEN EventsAttendedCount * 2.5 > 30.0 THEN 30.0\n                ELSE EventsAttendedCount * 2.5\n            END AS EventsScore,\n            -- Courses (25% max, min(CoursesCompleted * 5.0, 25.0))\n            CASE\n                WHEN CoursesCompletedCount * 5.0 > 25.0 THEN 25.0\n                ELSE CoursesCompletedCount * 5.0\n            END AS CoursesScore,\n            -- Leadership (20% max, min(LeadershipRoles * 10.0, 20.0))\n            CASE\n                WHEN LeadershipRolesCount * 10.0 > 20.0 THEN 20.0\n                ELSE LeadershipRolesCount * 10.0\n            END AS LeadershipScore,\n            -- Committees (15% max, min(CommitteeTerms * 7.5, 15.0))\n            CASE\n                WHEN CommitteeTermsCount * 7.5 > 15.0 THEN 15.0\n                ELSE CommitteeTermsCount * 7.5\n            END AS CommitteesScore,\n            -- Tenure (10% max, min(TenureYears * 2.0, 10.0))\n            CASE\n                WHEN TenureYears * 2.0 > 10.0 THEN 10.0\n                ELSE TenureYears * 2.0\n            END AS TenureScore\n        FROM\n            MemberBase\n    )\nSELECT\n    PersonID,\n    DisplayName,\n    MemberNumber,\n    Segment,\n    Region,\n    CountryName,\n    City,\n    JoinDate,\n    EventsAttendedCount,\n    EventsScore,\n    CoursesCompletedCount,\n    CoursesScore,\n    LeadershipRolesCount,\n    LeadershipScore,\n    CommitteeTermsCount,\n    CommitteesScore,\n    TenureYears,\n    TenureScore,\n    (\n        EventsScore + CoursesScore + LeadershipScore + CommitteesScore + TenureScore\n    ) AS CompositeScore,\n    DENSE_RANK() OVER (\n        ORDER BY\n            (\n                EventsScore + CoursesScore + LeadershipScore + CommitteesScore + TenureScore\n            ) DESC\n    ) AS [Rank]\nFROM\n    ScoredMembers\nORDER BY\n    [Rank],\n    DisplayName",
    "Status": "Pending",
