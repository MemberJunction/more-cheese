{
  "fields": {
    "Name": "Membership Revenue YoY by Tier",
    "CategoryID": "16DC714B-8648-47B7-94D4-481CF18195AE",
    "Description": "Aggregates total membership dues revenue and distinct active member counts grouped by MembershipTier across the current fiscal year and prior fiscal year. Computes CurrentYearRevenue, PriorYearRevenue, and YoYGrowthPct. Excludes Cancelled periods.",
    "SQL": "WITH\n    YearlyStats AS (\n        SELECT\n            [MembershipTier],\n            SUM(\n                CASE\n                    WHEN YEAR([StartDate]) = {{ CurrentYear | sqlNumber }} THEN [DuesAmount]\n                    ELSE 0\n                END\n            ) AS [CurrentYearRevenue],\n            SUM(\n                CASE\n                    WHEN YEAR([StartDate]) = {{ PriorYear | sqlNumber }} THEN [DuesAmount]\n                    ELSE 0\n                END\n            ) AS [PriorYearRevenue],\n            COUNT(\n                DISTINCT CASE\n                    WHEN YEAR([StartDate]) = {{ CurrentYear | sqlNumber }} THEN [PersonID]\n                END\n            ) AS [CurrentYearMemberCount],\n            COUNT(\n                DISTINCT CASE\n                    WHEN YEAR([StartDate]) = {{ PriorYear | sqlNumber }} THEN [PersonID]\n                END\n            ) AS [PriorYearMemberCount]\n        FROM\n            [morecheese_members].[vwMembershipPeriods]\n        WHERE\n            [Status] <> 'Cancelled'\n            AND (\n                YEAR([StartDate]) = {{ CurrentYear | sqlNumber }}\n                OR YEAR([StartDate]) = {{ PriorYear | sqlNumber }}\n            )\n        GROUP BY\n            [MembershipTier]\n    )\nSELECT\n    [MembershipTier],\n    [CurrentYearRevenue],\n    [PriorYearRevenue],\n    CAST(\n        ([CurrentYearRevenue] - [PriorYearRevenue]) * 100.0 / NULLIF([PriorYearRevenue], 0) AS DECIMAL(18, 2)\n    ) AS [YoYGrowthPct],\n    [CurrentYearMemberCount],\n    [PriorYearMemberCount]\nFROM\n    YearlyStats\nORDER BY\n    [CurrentYearRevenue] DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
