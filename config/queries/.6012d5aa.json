{
  "fields": {
    "Name": "Annual Cohort Member Roster",
    "CategoryID": "27EE2C4E-69C5-437E-8CF0-8D0E1A1D5C0E",
    "Description": "Retrieves the complete member roster for a specific annual join cohort, including demographic attributes, organization affiliation, and initial period dues amount. Filters by cohort year, with optional segment and region filters.",
    "SQL": "SELECT\n    mp.ID AS MemberProfileID,\n    p.ID AS PersonID,\n    mp.MemberNumber,\n    p.DisplayName AS FullName,\n    mp.Organization,\n    mp.Segment,\n    mp.Region,\n    mp.CountryName,\n    mp.City,\n    mp.State,\n    mp.JoinDate,\n    YEAR(mp.JoinDate) AS CohortYear,\n    ms.DuesAmount AS InitialDues,\n    ms.MembershipTier,\n    ms.Status AS PeriodStatus\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [morecheese_members].[vwMembershipPeriods] ms ON mp.PersonID = ms.PersonID\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mp.PersonID = p.ID\nWHERE\n    ms.PeriodKey LIKE '%-P1'\n    AND YEAR(mp.JoinDate) = {{ CohortYear | sqlNumber }} {% if Segment %}\n    AND mp.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n    AND mp.Region = {{ Region | sqlString }} {% endif %}\nORDER BY\n    mp.JoinDate DESC,\n    p.LastName ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
