    "Name": "Member Roster Details",
    "CategoryID": "A1A42040-DA6A-4053-B713-7BAC7C352112",
    "Description": "Returns the complete active member roster enriched with profile and personal identity details. Filters by membership status, tier, and professional segment.",
    "SQL": "SELECT\n    p.ID AS PersonID,\n    mper.ID AS MembershipPeriodID,\n    mp.ID AS MemberProfileID,\n    mp.MemberNumber,\n    p.DisplayName AS MemberName,\n    mper.MembershipTier,\n    mp.Organization,\n    mp.Segment,\n    mp.City,\n    mp.State,\n    mp.CountryName,\n    CONCAT(mp.City, ', ', mp.State) AS [Location],\n    mper.DuesAmount,\n    mper.RenewalDate,\n    mper.StartDate,\n    mper.AutoRenew\nFROM\n    [morecheese_members].[vwMembershipPeriods] mper\n    INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON mper.PersonID = mp.PersonID\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mper.PersonID = p.ID\nWHERE\n    mper.[Status] = {{ Status | sqlString }} {% if Tiers and Tiers.length > 0 %}\n    AND mper.MembershipTier IN {{ Tiers | sqlIn }} {% endif %} {% if Segments and Segments.length > 0 %}\n    AND mp.Segment IN {{ Segments | sqlIn }} {% endif %} {% if SearchTerm and SearchTerm != '' %}\n    AND (\n        p.DisplayName LIKE {{ SearchTerm | sqlLikeContains }}\n        OR mp.MemberNumber LIKE {{ SearchTerm | sqlLikeContains }}\n    ) {% endif %}\nORDER BY\n    MemberName ASC",
    "Status": "Pending",
    "QualityRank": 0,
