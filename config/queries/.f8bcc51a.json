{
  "fields": {
    "Name": "Total Outstanding Receivables By Due Month",
    "CategoryID": "FB712356-61E4-4992-8712-41C91FCDE085",
    "Description": "Aggregates outstanding receivables by due date month for aging analysis. Filters for orders with a positive balance in Confirmed or Posted status.",
    "SQL": "SELECT\n    YEAR([DueDate]) AS [DueYear],\n    MONTH([DueDate]) AS [DueMonth],\n    SUM([Balance]) AS [TotalOutstanding],\n    COUNT(*) AS [OrderCount]\nFROM\n    [__mj_BizAppsOrders].[vwOrderHeaders]\nWHERE\n    [Balance] > 0\n    AND [Status] IN ('Confirmed', 'Posted') {% if MinDueDate %}\n    AND [DueDate] >= {{ MinDueDate | sqlDate }} {% endif %} {% if MaxDueDate %}\n    AND [DueDate] <= {{ MaxDueDate | sqlDate }} {% endif %}\nGROUP BY\n    YEAR([DueDate]),\n    MONTH([DueDate])\nORDER BY\n    [DueYear] DESC,\n    [DueMonth] DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
