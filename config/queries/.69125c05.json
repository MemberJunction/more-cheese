{
  "fields": {
    "Name": "Course Performance Summary",
    "CategoryID": "972753F6-0627-41DB-8A68-1B829F8DF53C",
    "Description": "Aggregates course-level enrollment performance, including counts for completed, in-progress, and dropped statuses, along with the overall completion rate percentage.",
    "SQL": "SELECT\n    c.ID AS CourseID,\n    c.Name AS CourseName,\n    c.DurationWeeks,\n    c.StartDate,\n    COUNT(e.ID) AS TotalEnrolled,\n    SUM(\n        CASE\n            WHEN e.[Status] = 'Completed' THEN 1\n            ELSE 0\n        END\n    ) AS CompletedCount,\n    SUM(\n        CASE\n            WHEN e.[Status] = 'InProgress' THEN 1\n            ELSE 0\n        END\n    ) AS InProgressCount,\n    SUM(\n        CASE\n            WHEN e.[Status] = 'Dropped' THEN 1\n            ELSE 0\n        END\n    ) AS DroppedCount,\n    CAST(\n        SUM(\n            CASE\n                WHEN e.[Status] = 'Completed' THEN 1\n                ELSE 0\n            END\n        ) * 100.0 / NULLIF(COUNT(e.ID), 0) AS DECIMAL(18, 2)\n    ) AS CompletionRate\nFROM\n    [morecheese_learning].[vwCourses] AS c\n    LEFT JOIN [morecheese_learning].[vwCourseEnrollments] AS e ON c.ID = e.CourseID\nWHERE\n    1 = 1 {% if CourseName and CourseName.length > 0 %}\n    AND c.Name LIKE {{ CourseName | sqlLikeContains }} {% endif %} {% if MinStartDate %}\n    AND c.StartDate >= {{ MinStartDate | sqlDate }} {% endif %} {% if MaxStartDate %}\n    AND c.StartDate <= {{ MaxStartDate | sqlDate }} {% endif %}\nGROUP BY\n    c.ID,\n    c.Name,\n    c.DurationWeeks,\n    c.StartDate",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
