{
  "fields": {
    "Name": "Member Activity Timeline",
    "CategoryID": "F8B084A3-3D45-4896-98B7-FEE5736FA71F",
    "Description": "Returns a unified chronological activity timeline for a specified member across event registrations, course enrollments, and advocacy actions.",
    "SQL": "SELECT\n    ID AS ActivityID,\n    PersonID,\n    RegisteredOn AS ActivityDate,\n    'Event' AS ActivityType,\n    Event AS Title,\n    CASE\n        WHEN Attended = 1 THEN 'Attended'\n        WHEN Attended = 0 THEN 'No Show'\n        ELSE 'Registered'\n    END AS DetailStatus\nFROM\n    [morecheese_events].[vwEventRegistrations]\nWHERE\n    PersonID = {{ PersonID | sqlString }} {% if StartDate %}\n    AND RegisteredOn >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND RegisteredOn <= {{ EndDate | sqlDate }} {% endif %} {% if ActivityTypes and ActivityTypes.length > 0 %}\n    AND 'Event' IN {{ ActivityTypes | sqlIn }} {% endif %}\nUNION ALL\nSELECT\n    ID AS ActivityID,\n    PersonID,\n    EnrolledOn AS ActivityDate,\n    'Course' AS ActivityType,\n    Course AS Title,\n    Status AS DetailStatus\nFROM\n    [morecheese_learning].[vwCourseEnrollments]\nWHERE\n    PersonID = {{ PersonID | sqlString }} {% if StartDate %}\n    AND EnrolledOn >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND EnrolledOn <= {{ EndDate | sqlDate }} {% endif %} {% if ActivityTypes and ActivityTypes.length > 0 %}\n    AND 'Course' IN {{ ActivityTypes | sqlIn }} {% endif %}\nUNION ALL\nSELECT\n    ID AS ActivityID,\n    PersonID,\n    ActionDate AS ActivityDate,\n    'Advocacy' AS ActivityType,\n    Topic AS Title,\n    Kind AS DetailStatus\nFROM\n    [morecheese_members].[vwAdvocacyActions]\nWHERE\n    PersonID = {{ PersonID | sqlString }} {% if StartDate %}\n    AND ActionDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND ActionDate <= {{ EndDate | sqlDate }} {% endif %} {% if ActivityTypes and ActivityTypes.length > 0 %}\n    AND 'Advocacy' IN {{ ActivityTypes | sqlIn }} {% endif %}\nORDER BY\n    ActivityDate DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
