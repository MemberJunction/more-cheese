{
  "fields": {
    "Name": "Member Transaction Ledger by Cohort",
    "CategoryID": "AD5719EE-0FE4-44D2-A919-7AA8A1C94332",
    "Description": "Provides a flattened, paginated line-item ledger of member transactions enriched with member profile details, order attributes, and product classification. Filters for confirmed sales and supports cohort, category, and segment analysis.",
    "SQL": "SELECT\n    ol.ID AS OrderLineID,\n    oh.ID AS OrderHeaderID,\n    mp.ID AS MemberProfileID,\n    p.ID AS PersonID,\n    mp.MemberNumber,\n    p.DisplayName AS MemberName,\n    mp.Segment,\n    mp.Region,\n    mp.JoinDate,\n    YEAR(mp.JoinDate) AS CohortYear,\n    oh.OrderNumber,\n    oh.OrderDate,\n    oh.[Status] AS OrderStatus,\n    prod.ID AS ProductID,\n    prod.[Name] AS ProductName,\n    pc.ID AS ProductCategoryID,\n    pc.[Name] AS ProductCategoryName,\n    prod.ProductType,\n    ol.Quantity,\n    ol.UnitPrice,\n    ol.LineTotalGross\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mp.PersonID = p.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON oh.BillToPersonID = p.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderLines] ol ON ol.OrderHeaderID = oh.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProducts] prod ON ol.ProductID = prod.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProductCategories] pc ON prod.ProductCategoryID = pc.ID\nWHERE\n    oh.OrderType = 'Sale'\n    AND oh.[Status] IN ('Confirmed', 'Posted', 'Fulfilled')\n    AND ol.IsRollupParent = 0 {% if CohortYear %}\n    AND YEAR(mp.JoinDate) = {{ CohortYear | sqlNumber }} {% endif %} {% if ProductCategoryID %}\n    AND prod.ProductCategoryID = {{ ProductCategoryID | sqlString }} {% endif %} {% if ProductType %}\n    AND prod.ProductType = {{ ProductType | sqlString }} {% endif %} {% if Segment %}\n    AND mp.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n    AND mp.Region = {{ Region | sqlString }} {% endif %} {% if SearchTerm %}\n    AND (\n        mp.MemberNumber LIKE {{ SearchTerm | sqlLikeContains }}\n        OR p.DisplayName LIKE {{ SearchTerm | sqlLikeContains }}\n        OR oh.OrderNumber LIKE {{ SearchTerm | sqlLikeContains }}\n        OR prod.[Name] LIKE {{ SearchTerm | sqlLikeContains }}\n    ) {% endif %}\nORDER BY\n    oh.OrderDate DESC,\n    ol.ID ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
