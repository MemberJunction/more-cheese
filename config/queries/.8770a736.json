{
  "fields": {
    "Name": "Member Acquisition and Initial Dues by Cohort",
    "CategoryID": "3F3630FF-D956-4A14-AAE9-08E9FA15B872",
    "Description": "Aggregates annual member acquisitions and first-year dues revenue by cohort year, segment, and region for the 5-year analysis timeframe (2022-present).",
    "SQL": "SELECT\n    YEAR(mp.JoinDate) AS CohortYear,\n    mp.Segment,\n    mp.Region,\n    COUNT(DISTINCT mp.ID) AS NewMemberCount,\n    SUM(mper.DuesAmount) AS TotalInitialDues,\n    CAST(AVG(mper.DuesAmount) AS DECIMAL(18, 2)) AS AvgInitialDues\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [morecheese_members].[vwMembershipPeriods] mper ON mp.PersonID = mper.PersonID\nWHERE\n    mper.PeriodKey LIKE '%-P1'\n    AND mp.JoinDate >= {{ MinJoinDate | sqlDate }} {% if Segments and Segments.length > 0 %}\n    AND mp.Segment IN {{ Segments | sqlIn }} {% endif %} {% if Regions and Regions.length > 0 %}\n    AND mp.Region IN {{ Regions | sqlIn }} {% endif %}\nGROUP BY\n    YEAR(mp.JoinDate),\n    mp.Segment,\n    mp.Region\nORDER BY\n    CohortYear DESC,\n    mp.Segment,\n    mp.Region",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
