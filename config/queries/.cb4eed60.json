{
  "fields": {
    "Name": "Organization Member Activity Breakdown",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Retrieves individual member employee roster details for a selected organization, including their distinct event registrations, course enrollments, and total activity.",
    "SQL": "SELECT\n    mp.ID AS MemberProfileID,\n    mp.PersonID,\n    mp.OrganizationID,\n    p.DisplayName AS MemberName,\n    mp.MemberNumber,\n    p.CurrentJobTitle AS JobTitle,\n    mp.Segment,\n    COUNT(DISTINCT er.ID) AS EventCount,\n    COUNT(DISTINCT ce.ID) AS CourseCount,\n    COUNT(DISTINCT er.ID) + COUNT(DISTINCT ce.ID) AS TotalActivity,\n    mp.JoinDate\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mp.PersonID = p.ID\n    INNER JOIN [__mj_BizAppsCommon].[vwOrganizations] o ON mp.OrganizationID = o.ID\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON mp.PersonID = er.PersonID\n    LEFT JOIN [morecheese_learning].[vwCourseEnrollments] ce ON mp.PersonID = ce.PersonID\nWHERE\n    1 = 1 {% if OrganizationID %}\n    AND mp.OrganizationID = {{ OrganizationID | sqlString }} {% endif %}\nGROUP BY\n    mp.ID,\n    mp.PersonID,\n    mp.OrganizationID,\n    p.DisplayName,\n    mp.MemberNumber,\n    p.CurrentJobTitle,\n    mp.Segment,\n    mp.JoinDate\nORDER BY\n    TotalActivity DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
