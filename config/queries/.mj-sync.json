{
  "entity": "MJ: Queries",
  "filePattern": "**/.*.json",
  "pull": {
    "filePattern": ".*.json",
    "createNewFileIfNotFound": true,
    "newFileName": ".queries.json",
    "updateExistingRecords": true,
    "mergeStrategy": "overwrite",
    "excludeFields": [
      "__mj_CreatedAt",
      "__mj_UpdatedAt",
      "__mj_DeletedAt"
    ],
    "ignoreVirtualFields": true,
    "ignoreNullFields": true,
    "lookupFields": {
      "UserID": {
        "entity": "MJ: Users",
        "field": "Email"
      }
    },
    "_note": "Parameters/fields/entities are regenerated by the Query server class on save; do not pull them."
  }
}