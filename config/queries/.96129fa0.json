{
  "fields": {
    "Name": "Course Cohort Enrolled Students",
    "CategoryID": "44D30D65-E0DC-4F70-984E-06E5041756F0",
    "Description": "Retrieves the enriched student roster for a specific course enrollment cohort, including student contact details, organization info, and enrollment status.",
    "SQL": "SELECT\n    ce.ID AS EnrollmentID,\n    ce.PersonID,\n    ce.CourseID,\n    c.Name AS CourseName,\n    p.DisplayName AS StudentName,\n    p.PrimaryEmail AS Email,\n    p.CurrentOrganizationName AS OrganizationName,\n    p.CurrentJobTitle AS JobTitle,\n    ce.EnrolledOn,\n    ce.Status,\n    ce.CompletedOn,\n    DATEPART(year, ce.EnrolledOn) AS EnrollmentYear,\n    DATEPART(quarter, ce.EnrolledOn) AS EnrollmentQuarter,\n    CONCAT(\n        CAST(DATEPART(year, ce.EnrolledOn) AS VARCHAR(4)),\n        '-Q',\n        CAST(DATEPART(quarter, ce.EnrolledOn) AS VARCHAR(1))\n    ) AS QuarterLabel\nFROM\n    [morecheese_learning].[vwCourseEnrollments] ce\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON ce.PersonID = p.ID\n    INNER JOIN [morecheese_learning].[vwCourses] c ON ce.CourseID = c.ID\nWHERE\n    ce.CourseID = {{ CourseID | sqlString }} {% if Statuses and Statuses.length > 0 %}\n    AND ce.Status IN {{ Statuses | sqlIn }} {% endif %}\nORDER BY\n    ce.EnrolledOn DESC,\n    p.DisplayName ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
