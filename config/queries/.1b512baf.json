    "Description": "Returns the chronological history of attended events for federation members, including venue and format details. Supports filtering by member, event type, and date range.",
    "SQL": "SELECT\n    er.ID AS RegistrationID,\n    er.PersonID,\n    er.EventID,\n    e.Name AS EventName,\n    e.EventType,\n    e.EventDate,\n    e.IsVirtual,\n    e.City,\n    e.State,\n    er.RegisteredOn\nFROM\n    [morecheese_events].[vwEventRegistrations] er\n    INNER JOIN [morecheese_events].[vwEvents] e ON er.EventID = e.ID\nWHERE\n    er.Attended = 1 {% if PersonID %}\n    AND er.PersonID = {{ PersonID | sqlString }} {% endif %} {% if EventType %}\n    AND e.EventType = {{ EventType | sqlString }} {% endif %} {% if StartDate %}\n    AND e.EventDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND e.EventDate <= {{ EndDate | sqlDate }} {% endif %}\nORDER BY\n    e.EventDate DESC",
