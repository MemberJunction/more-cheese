{
  "fields": {
    "Name": "Committee Member Roster",
    "CategoryID": "4EB7ECFB-BAF4-4CD3-B054-FAF3CDEFBC04",
    "Description": "Provides a comprehensive, flattened member roster for chapters and committees. Returns one row per membership assignment with full person identity, role details, organization, and geographic location. Filterable by membership status and committee.",
    "SQL": "SELECT\n    m.ID AS MembershipID,\n    c.ID AS CommitteeID,\n    c.Name AS CommitteeName,\n    t.ID AS TermID,\n    t.Name AS TermName,\n    p.ID AS PersonID,\n    p.DisplayName AS MemberName,\n    mp.MemberNumber,\n    r.ID AS RoleID,\n    r.Name AS RoleName,\n    r.IsOfficer,\n    m.[Status] AS MembershipStatus,\n    m.StartDate,\n    m.EndDate,\n    mp.Organization AS OrganizationName,\n    mp.Segment,\n    mp.City,\n    mp.[State],\n    mp.CountryName,\n    p.PrimaryEmail AS Email,\n    p.PrimaryPhone AS Phone\nFROM\n    [__mj_BizAppsCommittees].[vwMemberships] AS m\n    INNER JOIN [__mj_BizAppsCommittees].[vwTerms] AS t ON m.TermID = t.ID\n    INNER JOIN [__mj_BizAppsCommittees].[vwCommittees] AS c ON t.CommitteeID = c.ID\n    INNER JOIN [__mj_BizAppsCommittees].[vwRoles] AS r ON m.RoleID = r.ID\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] AS p ON m.PersonID = p.ID\n    INNER JOIN [morecheese_members].[vwMemberProfiles] AS mp ON p.ID = mp.PersonID\nWHERE\n    1 = 1 {% if MembershipStatus %}\n    AND m.[Status] = {{ MembershipStatus | sqlString }} {% endif %} {% if CommitteeID %}\n    AND c.ID = {{ CommitteeID | sqlString }} {% endif %}\nORDER BY\n    c.Name ASC,\n    r.Sequence ASC,\n    p.LastName ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
