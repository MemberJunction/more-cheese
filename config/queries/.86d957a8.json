{
  "fields": {
    "Name": "Active Membership Count and Dues By Tier",
    "CategoryID": "91FA28D2-A699-47E4-9708-33003D5A22F9",
    "Description": "Aggregates active memberships by tier, providing counts and total annual dues. Includes optional filters for member segment and region.",
    "SQL": "SELECT\n    mp.[MembershipTier],\n    COUNT(DISTINCT mp.[PersonID]) AS [ActiveMemberCount],\n    SUM(mp.[DuesAmount]) AS [TotalAnnualDues]\nFROM\n    [morecheese_members].[vwMembershipPeriods] mp\n    INNER JOIN [morecheese_members].[vwMemberProfiles] m ON mp.[PersonID] = m.[PersonID]\nWHERE\n    mp.[Status] = {{ Status | sqlString }} {% if Segments and Segments.length > 0 %}\n    AND m.[Segment] IN {{ Segments | sqlIn }} {% endif %} {% if Regions and Regions.length > 0 %}\n    AND m.[Region] IN {{ Regions | sqlIn }} {% endif %}\nGROUP BY\n    mp.[MembershipTier]\nORDER BY\n    [ActiveMemberCount] DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
