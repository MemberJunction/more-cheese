{
  "fields": {
    "Name": "Monthly Revenue and Order Summary (1)",
    "CategoryID": "FD4C8862-E63F-4509-B702-62D345521487",
    "Description": "Aggregates order counts and financial metrics (TotalGross, AmountPaid, Balance) grouped by calendar year and calendar month from Order Headers. Supports filtering by OrderType, Status, and a specific year for dashboard visualization.",
    "SQL": "SELECT\n    YEAR(OrderDate) AS OrderYear,\n    MONTH(OrderDate) AS OrderMonth,\n    DATENAME(MONTH, OrderDate) AS MonthName,\n    COUNT(*) AS OrderCount,\n    SUM(TotalGross) AS TotalGrossRevenue,\n    SUM(AmountPaid) AS TotalAmountPaid,\n    SUM(Balance) AS TotalBalance\nFROM\n    [__mj_BizAppsOrders].[vwOrderHeaders]\nWHERE\n    OrderType = {{ OrderType | sqlString }}\n    AND [Status] IN {{ Statuses | sqlIn }} {% if SelectedYear %}\n    AND YEAR(OrderDate) = {{ SelectedYear | sqlNumber }} {% endif %}\nGROUP BY\n    YEAR(OrderDate),\n    MONTH(OrderDate),\n    DATENAME(MONTH, OrderDate)\nORDER BY\n    OrderYear DESC,\n    OrderMonth ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
