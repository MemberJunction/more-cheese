{
  "fields": {
    "Name": "Event Only Members Summary",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Identifies federation members who have attended at least one event but have zero course enrollments. Provides a summary of their profile details and total attended event count.",
    "SQL": "SELECT\n    p.ID AS PersonID,\n    mp.ID AS MemberProfileID,\n    p.DisplayName AS MemberName,\n    mp.MemberNumber,\n    p.CurrentOrganizationID AS OrganizationID,\n    p.CurrentOrganizationName AS OrganizationName,\n    mp.Segment,\n    mp.Region,\n    mp.Country,\n    mp.City,\n    mp.State,\n    mp.JoinDate,\n    COUNT(er.ID) AS AttendedEventsCount\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mp.PersonID = p.ID\n    INNER JOIN [morecheese_events].[vwEventRegistrations] er ON p.ID = er.PersonID\nWHERE\n    er.Attended = 1\n    AND NOT EXISTS (\n        SELECT\n            1\n        FROM\n            [morecheese_learning].[vwCourseEnrollments] ce\n        WHERE\n            ce.PersonID = p.ID\n    ) {% if Segment %}\n    AND mp.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n    AND mp.Region = {{ Region | sqlString }} {% endif %}\nGROUP BY\n    p.ID,\n    mp.ID,\n    p.DisplayName,\n    mp.MemberNumber,\n    p.CurrentOrganizationID,\n    p.CurrentOrganizationName,\n    mp.Segment,\n    mp.Region,\n    mp.Country,\n    mp.City,\n    mp.State,\n    mp.JoinDate\nHAVING\n    COUNT(er.ID) >= {{ MinAttendedEvents | sqlNumber }}\nORDER BY\n    AttendedEventsCount DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
