{
  "fields": {
    "Name": "Organization Member Activity Ranking",
    "CategoryID": "310D55CB-124C-4C59-9202-9378ADB3BC27",
    "Description": "Produces a ranked leaderboard of organizations based on member counts and combined activity from event registrations and course enrollments.",
    "SQL": "SELECT\n    o.ID AS OrganizationID,\n    o.Name AS OrganizationName,\n    COUNT(DISTINCT m.PersonID) AS MemberCount,\n    COUNT(DISTINCT e.ID) AS EventCount,\n    COUNT(DISTINCT c.ID) AS CourseCount,\n    COUNT(DISTINCT e.ID) + COUNT(DISTINCT c.ID) AS TotalActivity\nFROM\n    [__mj_BizAppsCommon].[vwOrganizations] o\n    INNER JOIN [morecheese_members].[vwMemberProfiles] m ON o.ID = m.OrganizationID\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] e ON m.PersonID = e.PersonID\n    LEFT JOIN [morecheese_learning].[vwCourseEnrollments] c ON m.PersonID = c.PersonID\nGROUP BY\n    o.ID,\n    o.Name\nHAVING\n    COUNT(DISTINCT m.PersonID) >= {{ MinMemberCount | sqlNumber }}\nORDER BY\n    TotalActivity DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
