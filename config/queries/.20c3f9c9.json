{
  "fields": {
    "Name": "Top Members By Tier Revenue",
    "CategoryID": "16DC714B-8648-47B7-94D4-481CF18195AE",
    "Description": "Ranks members within each membership tier based on their cumulative dues revenue. Includes total revenue, period counts, and join/end dates.",
    "SQL": "WITH\n    MemberAggregates AS (\n        SELECT\n            mp.PersonID,\n            mp.Person,\n            m.MemberNumber,\n            mp.MembershipTier,\n            SUM(mp.DuesAmount) AS TotalDuesRevenue,\n            COUNT(DISTINCT mp.ID) AS PeriodCount,\n            MIN(mp.StartDate) AS FirstJoinDate,\n            MAX(mp.EndDate) AS LatestPeriodEnd\n        FROM\n            [morecheese_members].[vwMembershipPeriods] mp\n            INNER JOIN [morecheese_members].[vwMemberProfiles] m ON mp.PersonID = m.PersonID\n        WHERE\n            1 = 1 {% if MembershipTiers and MembershipTiers.length > 0 %}\n            AND mp.MembershipTier IN {{ MembershipTiers | sqlIn }} {% endif %}\n        GROUP BY\n            mp.PersonID,\n            mp.Person,\n            m.MemberNumber,\n            mp.MembershipTier\n    )\nSELECT\n    PersonID,\n    Person,\n    MemberNumber,\n    MembershipTier,\n    TotalDuesRevenue,\n    PeriodCount,\n    FirstJoinDate,\n    LatestPeriodEnd,\n    RANK() OVER (\n        PARTITION BY\n            MembershipTier\n        ORDER BY\n            TotalDuesRevenue DESC\n    ) AS TierRank\nFROM\n    MemberAggregates\nWHERE\n    1 = 1 {% if MinRevenue %}\n    AND TotalDuesRevenue >= {{ MinRevenue | sqlNumber }} {% endif %}\nORDER BY\n    MembershipTier,\n    TierRank",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
