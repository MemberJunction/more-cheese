{
  "fields": {
    "Name": "Annual Revenue By Product Category",
    "CategoryID": "FD4C8862-E63F-4509-B702-62D345521487",
    "Description": "Aggregates annual revenue, order volume, and line item counts by product category. Filters for specific order statuses and excludes rollup parent lines.",
    "SQL": "SELECT\n    YEAR(oh.OrderDate) AS [Year],\n    pc.ID AS CategoryID,\n    pc.Name AS CategoryName,\n    SUM(ol.LineTotalGross) AS CategoryRevenue,\n    COUNT(DISTINCT oh.ID) AS OrderCount,\n    COUNT(ol.ID) AS LineCount\nFROM\n    [__mj_BizAppsOrders].[vwOrderLines] ol\n    JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON ol.OrderHeaderID = oh.ID\n    JOIN [__mj_BizAppsOrders].[vwProducts] p ON ol.ProductID = p.ID\n    JOIN [__mj_BizAppsOrders].[vwProductCategories] pc ON p.ProductCategoryID = pc.ID\nWHERE\n    1 = 1 {% if StatusList and StatusList.length > 0 %}\n    AND oh.[Status] IN {{ StatusList | sqlIn }} {% else %}\n    AND oh.[Status] IN ('Confirmed', 'Posted') {% endif %}\n    AND ol.IsRollupParent = 0 {% if StartYear %}\n    AND YEAR(oh.OrderDate) >= {{ StartYear | sqlNumber }} {% endif %} {% if EndYear %}\n    AND YEAR(oh.OrderDate) <= {{ EndYear | sqlNumber }} {% endif %}\nGROUP BY\n    YEAR(oh.OrderDate),\n    pc.ID,\n    pc.Name\nORDER BY\n    [Year] ASC,\n    CategoryRevenue DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
