{
  "fields": {
    "Name": "Annual Revenue Breakdown By Product Category",
    "CategoryID": "FD4C8862-E63F-4509-B702-62D345521487",
    "Description": "Computes annual revenue breakdown grouped by Fiscal Year and Product Category, including transaction counts and percentage share of annual revenue. Filters by order status and optional year range.",
    "SQL": "WITH\n    CategorySummary AS (\n        SELECT\n            YEAR(oh.OrderDate) AS FiscalYear,\n            pc.ID AS ProductCategoryID,\n            pc.Name AS CategoryName,\n            SUM(ol.LineTotalGross) AS CategoryRevenue,\n            COUNT(DISTINCT oh.ID) AS TransactionCount\n        FROM\n            [__mj_BizAppsOrders].[vwOrderHeaders] oh\n            INNER JOIN [__mj_BizAppsOrders].[vwOrderLines] ol ON oh.ID = ol.OrderHeaderID\n            INNER JOIN [__mj_BizAppsOrders].[vwProducts] p ON ol.ProductID = p.ID\n            INNER JOIN [__mj_BizAppsOrders].[vwProductCategories] pc ON p.ProductCategoryID = pc.ID\n        WHERE\n            oh.[Status] IN {{ StatusList | sqlIn }} {% if StartYear %}\n            AND YEAR(oh.OrderDate) >= {{ StartYear | sqlNumber }} {% endif %} {% if EndYear %}\n            AND YEAR(oh.OrderDate) <= {{ EndYear | sqlNumber }} {% endif %}\n        GROUP BY\n            YEAR(oh.OrderDate),\n            pc.ID,\n            pc.Name\n    ),\n    YearlyTotal AS (\n        SELECT\n            FiscalYear,\n            SUM(CategoryRevenue) AS TotalYearRevenue\n        FROM\n            CategorySummary\n        GROUP BY\n            FiscalYear\n    )\nSELECT\n    cs.FiscalYear,\n    cs.ProductCategoryID,\n    cs.CategoryName,\n    cs.CategoryRevenue,\n    cs.TransactionCount,\n    CAST(\n        cs.CategoryRevenue * 100.0 / NULLIF(yt.TotalYearRevenue, 0) AS DECIMAL(10, 2)\n    ) AS PercentageShare\nFROM\n    CategorySummary cs\n    JOIN YearlyTotal yt ON cs.FiscalYear = yt.FiscalYear\nORDER BY\n    cs.FiscalYear DESC,\n    cs.CategoryRevenue DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
