{
  "fields": {
    "Name": "Order Line Transactions By Product Category",
    "CategoryID": "A841A12C-2F66-48EB-B383-211D11D5A2C7",
    "Description": "Retrieves detailed order line transactions for Level 3 drilldown filtered by calendar year and product category. Includes order header details, product info, and fulfillment status.",
    "SQL": "SELECT\n    ol.OrderHeaderID,\n    ol.ID AS OrderLineID,\n    oh.OrderNumber,\n    oh.OrderDate,\n    oh.BillToPerson,\n    ol.ProductID,\n    p.Name AS ProductName,\n    p.ProductCategoryID,\n    pc.Name AS CategoryName,\n    ol.Quantity,\n    ol.UnitPrice,\n    ol.LineTotalGross,\n    oh.Status AS OrderStatus,\n    ol.FulfillmentStatus\nFROM\n    [__mj_BizAppsOrders].[vwOrderLines] ol\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON ol.OrderHeaderID = oh.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProducts] p ON ol.ProductID = p.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProductCategories] pc ON p.ProductCategoryID = pc.ID\nWHERE\n    oh.Status IN ('Confirmed', 'Posted')\n    AND ol.IsRollupParent = 0\n    AND YEAR(oh.OrderDate) = {{ Year | sqlNumber }}\n    AND p.ProductCategoryID = {{ CategoryID | sqlString }}\nORDER BY\n    oh.OrderDate DESC",
