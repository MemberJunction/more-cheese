{
  "fields": {
    "Name": "Annual Membership and Revenue Trends",
    "CategoryID": "5478D31A-2876-4CEA-A4A9-511F55F49A3A",
    "Description": "Aggregates 5-year longitudinal executive metrics across fiscal years. For each fiscal year, calculates total gross revenue from confirmed/posted orders, distinct active member count, total completed orders, and year-over-year growth percentages for both revenue and membership.",
    "SQL": "WITH\n    Years AS (\n        -- Generate the target year plus one preceding year to calculate YoY for the start of the range\n        SELECT\n            {{ EndYear | sqlNumber }} AS FiscalYear\n        UNION ALL\n        SELECT\n            {{ EndYear | sqlNumber }} - 1\n        UNION ALL\n        SELECT\n            {{ EndYear | sqlNumber }} - 2\n        UNION ALL\n        SELECT\n            {{ EndYear | sqlNumber }} - 3\n        UNION ALL\n        SELECT\n            {{ EndYear | sqlNumber }} - 4\n        UNION ALL\n        SELECT\n            {{ EndYear | sqlNumber }} - 5\n    ),\n    FiscalYearBounds AS (\n        SELECT\n            FiscalYear,\n            DATEFROMPARTS(FiscalYear, 1, 1) AS StartDate,\n            DATEFROMPARTS(FiscalYear, 12, 31) AS EndDate\n        FROM\n            Years\n    ),\n    OrderMetrics AS (\n        SELECT\n            f.FiscalYear,\n            SUM(ISNULL(o.TotalGross, 0)) AS TotalGrossRevenue,\n            COUNT(o.ID) AS OrderCount\n        FROM\n            FiscalYearBounds f\n            LEFT JOIN [__mj_BizAppsOrders].[vwOrderHeaders] o ON o.OrderDate >= f.StartDate\n            AND o.OrderDate <= f.EndDate\n            AND o.[Status] IN ('Confirmed', 'Posted')\n        GROUP BY\n            f.FiscalYear\n    ),\n    MemberMetrics AS (\n        SELECT\n            f.FiscalYear,\n            COUNT(DISTINCT m.PersonID) AS ActiveMemberCount\n        FROM\n            FiscalYearBounds f\n            LEFT JOIN [morecheese_members].[vwMembershipPeriods] m ON m.StartDate <= f.EndDate\n            AND m.EndDate >= f.StartDate\n            AND m.[Status] IN ('Active', 'Renewed')\n        GROUP BY\n            f.FiscalYear\n    ),\n    CombinedMetrics AS (\n        SELECT\n            o.FiscalYear,\n            o.TotalGrossRevenue,\n            o.OrderCount,\n            m.ActiveMemberCount,\n            LAG(o.TotalGrossRevenue) OVER (\n                ORDER BY\n                    o.FiscalYear\n            ) AS PrevRevenue,\n            LAG(m.ActiveMemberCount) OVER (\n                ORDER BY\n                    m.FiscalYear\n            ) AS PrevMembers\n        FROM\n            OrderMetrics o\n            JOIN MemberMetrics m ON o.FiscalYear = m.FiscalYear\n    )\nSELECT\n    FiscalYear,\n    ActiveMemberCount,\n    TotalGrossRevenue,\n    OrderCount,\n    -- YoY Growth Calculation: (Current - Previous) / Previous * 100\n    CAST(\n        CASE\n            WHEN PrevMembers IS NULL\n            OR PrevMembers = 0 THEN NULL\n            ELSE (ActiveMemberCount - PrevMembers) * 100.0 / PrevMembers\n        END AS DECIMAL(18, 2)\n    ) AS MemberGrowthPctYoY,\n    CAST(\n        CASE\n            WHEN PrevRevenue IS NULL\n            OR PrevRevenue = 0 THEN NULL\n            ELSE (TotalGrossRevenue - PrevRevenue) * 100.0 / PrevRevenue\n        END AS DECIMAL(18, 2)\n    ) AS RevenueGrowthPctYoY\nFROM\n    CombinedMetrics\nWHERE\n    FiscalYear > {{ EndYear | sqlNumber }} - 5\nORDER BY\n    FiscalYear ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
