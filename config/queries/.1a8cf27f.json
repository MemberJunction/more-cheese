{
  "fields": {
    "Name": "Top Members by Total Revenue",
    "CategoryID": "16DC714B-8648-47B7-94D4-481CF18195AE",
    "Description": "Returns the top contributing members ranked by total gross revenue within a selected membership tier for a specified fiscal period. Filters by Confirmed orders and sums line totals.",
    "SQL": "SELECT\n    p.ID AS PersonID,\n    p.DisplayName AS MemberName,\n    mprof.MemberNumber,\n    mprof.Segment,\n    mprof.Organization AS OrganizationName,\n    mp.MembershipTier,\n    SUM(ol.LineTotalGross) AS MemberRevenueTotal,\n    COUNT(DISTINCT oh.ID) AS TransactionCount\nFROM\n    [morecheese_members].[vwMembershipPeriods] mp\n    INNER JOIN [morecheese_members].[vwMemberProfiles] mprof ON mp.PersonID = mprof.PersonID\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mp.PersonID = p.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON p.ID = oh.BillToPersonID\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderLines] ol ON oh.ID = ol.OrderHeaderID\nWHERE\n    mp.MembershipTier = {{ MembershipTier | sqlString }}\n    AND oh.[Status] = 'Confirmed' {% if StartDate %}\n    AND oh.OrderDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND oh.OrderDate <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    p.ID,\n    p.DisplayName,\n    mprof.MemberNumber,\n    mprof.Segment,\n    mprof.Organization,\n    mp.MembershipTier\nORDER BY\n    MemberRevenueTotal DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
