{
  "fields": {
    "Name": "Weekly Activity Trends By Chapter",
    "CategoryID": "4D499ED2-94EF-42BD-A04E-5621EAA89B44",
    "Description": "Aggregates weekly engagement volume (events, courses, committees) per chapter across trailing quarters to drive sparkline visualizations.",
    "SQL": "WITH\n    RawActivities AS (\n        -- Event Attendances (Attended = 1)\n        SELECT\n            mp.OrganizationID,\n            CAST(e.EventDate AS DATE) AS ActivityDate\n        FROM\n            [morecheese_events].[vwEventRegistrations] er\n            INNER JOIN [morecheese_events].[vwEvents] e ON er.EventID = e.ID\n            INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON er.PersonID = mp.PersonID\n        WHERE\n            er.Attended = 1\n            AND mp.OrganizationID IS NOT NULL\n        UNION ALL\n        -- Course Completions (Status = 'Completed')\n        SELECT\n            mp.OrganizationID,\n            CAST(ce.CompletedOn AS DATE) AS ActivityDate\n        FROM\n            [morecheese_learning].[vwCourseEnrollments] ce\n            INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON ce.PersonID = mp.PersonID\n        WHERE\n            ce.[Status] = 'Completed'\n            AND mp.OrganizationID IS NOT NULL\n        UNION ALL\n        -- Committee Attendances (AttendanceStatus = 'Present')\n        SELECT\n            mp.OrganizationID,\n            CAST(m.StartDateTime AS DATE) AS ActivityDate\n        FROM\n            [__mj_BizAppsCommittees].[vwAttendances] a\n            INNER JOIN [__mj_BizAppsCommittees].[vwMeetings] m ON a.MeetingID = m.ID\n            INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON a.PersonID = mp.PersonID\n        WHERE\n            a.AttendanceStatus = 'Present'\n            AND mp.OrganizationID IS NOT NULL\n    ),\n    QuarterlyActivity AS (\n        SELECT\n            OrganizationID,\n            ActivityDate,\n            DATEPART(YEAR, ActivityDate) AS [Year],\n            DATEPART(QUARTER, ActivityDate) AS QuarterNumber,\n            -- Determine the start date of the quarter for relative week calculation\n            DATEFROMPARTS(\n                DATEPART(YEAR, ActivityDate),\n                ((DATEPART(QUARTER, ActivityDate) - 1) * 3) + 1,\n                1\n            ) AS QuarterStartDate\n        FROM\n            RawActivities\n        WHERE\n            ActivityDate >= DATEADD(QUARTER, - {{ TrailingQuarters | sqlNumber }}, GETDATE())\n    ),\n    WeeklyActivity AS (\n        SELECT\n            OrganizationID,\n            [Year],\n            QuarterNumber,\n            CONCAT([Year], '-Q', QuarterNumber) AS QuarterKey,\n            -- Intra-quarter week index (1-13) calculated as 7-day buckets from quarter start\n            (DATEDIFF(DAY, QuarterStartDate, ActivityDate) / 7) + 1 AS WeekNumberInQuarter,\n            -- Start date of the 7-day bucket\n            DATEADD(\n                DAY,\n                (DATEDIFF(DAY, QuarterStartDate, ActivityDate) / 7) * 7,\n                QuarterStartDate\n            ) AS WeekStartDate,\n            COUNT(*) AS WeeklyActivityCount\n        FROM\n            QuarterlyActivity\n        GROUP BY\n            OrganizationID,\n            [Year],\n            QuarterNumber,\n            QuarterStartDate,\n            (DATEDIFF(DAY, QuarterStartDate, ActivityDate) / 7) + 1,\n            DATEADD(\n                DAY,\n                (DATEDIFF(DAY, QuarterStartDate, ActivityDate) / 7) * 7,\n                QuarterStartDate\n            )\n    )\nSELECT\n    OrganizationID,\n    QuarterKey,\n    [Year],\n    QuarterNumber,\n    WeekNumberInQuarter,\n    CAST(WeekStartDate AS DATE) AS WeekStartDate,\n    WeeklyActivityCount\nFROM\n    WeeklyActivity\nWHERE\n    WeekNumberInQuarter <= 13\nORDER BY\n    OrganizationID,\n    [Year] DESC,\n    QuarterNumber DESC,\n    WeekNumberInQuarter ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
