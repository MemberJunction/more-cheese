{
  "fields": {
    "Name": "Member Engagement Leaderboard (2)",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Calculates normalized multi-dimensional engagement scores (0-100) for all currently active federation members and returns ranked leaderboard rows with full factor score breakdowns (Events, Courses, Leadership, Committees, Tenure).",
    "SQL": "WITH\n    LatestPeriods AS (\n        SELECT\n            PersonID,\n            [Status],\n            ROW_NUMBER() OVER (\n                PARTITION BY\n                    PersonID\n                ORDER BY\n                    EndDate DESC,\n                    __mj_CreatedAt DESC\n            ) AS RowNum\n        FROM\n            [morecheese_members].[vwMembershipPeriods]\n    ),\n    ActiveMembers AS (\n        SELECT\n            p.ID AS PersonID,\n            mp.ID AS MemberProfileID,\n            mp.MemberNumber,\n            p.DisplayName AS MemberName,\n            mp.Organization,\n            mp.Segment,\n            mp.JoinDate,\n            DATEDIFF(DAY, mp.JoinDate, GETDATE()) / 365.25 AS TenureYears\n        FROM\n            [__mj_BizAppsCommon].[vwPeople] p\n            INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON p.ID = mp.PersonID\n            INNER JOIN LatestPeriods lp ON p.ID = lp.PersonID\n        WHERE\n            lp.RowNum = 1\n            AND lp.[Status] IN ('Active', 'Renewed')\n    ),\n    EventStats AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS AttendedCount\n        FROM\n            [morecheese_events].[vwEventRegistrations]\n        WHERE\n            Attended = 1\n        GROUP BY\n            PersonID\n    ),\n    CourseStats AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS CompletedCount\n        FROM\n            [morecheese_learning].[vwCourseEnrollments]\n        WHERE\n            [Status] = 'Completed'\n        GROUP BY\n            PersonID\n    ),\n    LeadershipStats AS (\n        SELECT\n            m.PersonID,\n            COUNT(*) AS LeaderCount\n        FROM\n            [__mj_BizAppsCommittees].[vwMemberships] m\n            INNER JOIN [__mj_BizAppsCommittees].[vwRoles] r ON m.RoleID = r.ID\n        WHERE\n            r.IsOfficer = 1\n            OR r.[Name] IN (\n                'Chair',\n                'Vice Chair',\n                'President',\n                'Treasurer',\n                'Secretary'\n            )\n        GROUP BY\n            m.PersonID\n    ),\n    CommitteeStats AS (\n        SELECT\n            PersonID,\n            COUNT(*) AS TotalCommittees\n        FROM\n            [__mj_BizAppsCommittees].[vwMemberships]\n        GROUP BY\n            PersonID\n    ),\n    Benchmarks AS (\n        SELECT\n            MAX(CAST(ISNULL(es.AttendedCount, 0) AS FLOAT)) AS MaxEvents,\n            MAX(CAST(ISNULL(cs.CompletedCount, 0) AS FLOAT)) AS MaxCourses,\n            MAX(CAST(ISNULL(ls.LeaderCount, 0) AS FLOAT)) AS MaxLeadership,\n            MAX(CAST(ISNULL(cm.TotalCommittees, 0) AS FLOAT)) AS MaxCommittees\n        FROM\n            ActiveMembers am\n            LEFT JOIN EventStats es ON am.PersonID = es.PersonID\n            LEFT JOIN CourseStats cs ON am.PersonID = cs.PersonID\n            LEFT JOIN LeadershipStats ls ON am.PersonID = ls.PersonID\n            LEFT JOIN CommitteeStats cm ON am.PersonID = cm.PersonID\n    ),\n    ScoredMembers AS (\n        SELECT\n            am.*,\n            ISNULL(es.AttendedCount, 0) AS EventCount,\n            ISNULL(cs.CompletedCount, 0) AS CourseCount,\n            ISNULL(ls.LeaderCount, 0) AS LeadershipCount,\n            ISNULL(cm.TotalCommittees, 0) AS CommitteeCount,\n            CASE\n                WHEN b.MaxEvents > 0 THEN (ISNULL(es.AttendedCount, 0) / b.MaxEvents) * 30.0\n                ELSE 0\n            END AS EventScore,\n            CASE\n                WHEN b.MaxCourses > 0 THEN (ISNULL(cs.CompletedCount, 0) / b.MaxCourses) * 25.0\n                ELSE 0\n            END AS CourseScore,\n            CASE\n                WHEN b.MaxLeadership > 0 THEN (ISNULL(ls.LeaderCount, 0) / b.MaxLeadership) * 20.0\n                ELSE 0\n            END AS LeadershipScore,\n            CASE\n                WHEN b.MaxCommittees > 0 THEN (ISNULL(cm.TotalCommittees, 0) / b.MaxCommittees) * 15.0\n                ELSE 0\n            END AS CommitteeScore,\n            CASE\n                WHEN am.TenureYears >= 10 THEN 10.0\n                ELSE am.TenureYears\n            END AS TenureScore\n        FROM\n            ActiveMembers am\n            CROSS JOIN Benchmarks b\n            LEFT JOIN EventStats es ON am.PersonID = es.PersonID\n            LEFT JOIN CourseStats cs ON am.PersonID = cs.PersonID\n            LEFT JOIN LeadershipStats ls ON am.PersonID = ls.PersonID\n            LEFT JOIN CommitteeStats cm ON am.PersonID = cm.PersonID\n    ),\n    FinalScores AS (\n        SELECT\n            *,\n            (\n                EventScore + CourseScore + LeadershipScore + CommitteeScore + TenureScore\n            ) AS CompositeScore\n        FROM\n            ScoredMembers\n    )\nSELECT\n    DENSE_RANK() OVER (\n        ORDER BY\n            CompositeScore DESC\n    ) AS [Rank],\n    PersonID,\n    MemberProfileID,\n    MemberNumber,\n    MemberName,\n    Organization,\n    Segment,\n    JoinDate,\n    TenureYears,\n    EventCount,\n    EventScore,\n    CourseCount,\n    CourseScore,\n    LeadershipCount,\n    LeadershipScore,\n    CommitteeCount,\n    CommitteeScore,\n    TenureScore,\n    CompositeScore\nFROM\n    FinalScores\nWHERE\n    CompositeScore >= {{ MinCompositeScore | sqlNumber }}\nORDER BY\n    CompositeScore DESC",
    "Status": "Pending",
