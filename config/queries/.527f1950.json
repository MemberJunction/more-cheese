{
  "fields": {
    "Name": "Member Activity By Organization",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Returns individual member employee engagement metrics (event registrations and course enrollments) for all staff members associated with a specific organization.",
    "SQL": "SELECT\n    mp.ID AS MemberProfileID,\n    mp.PersonID,\n    mp.OrganizationID,\n    p.DisplayName AS MemberName,\n    mp.MemberNumber,\n    p.Title AS JobTitle,\n    mp.Segment,\n    mp.City,\n    mp.State,\n    COUNT(DISTINCT er.ID) AS EventCount,\n    COUNT(DISTINCT ce.ID) AS CourseCount,\n    (COUNT(DISTINCT er.ID) + COUNT(DISTINCT ce.ID)) AS TotalActivity\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mp.PersonID = p.ID\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON mp.PersonID = er.PersonID\n    LEFT JOIN [morecheese_learning].[vwCourseEnrollments] ce ON mp.PersonID = ce.PersonID\nWHERE\n    1 = 1 {% if OrganizationID %}\n    AND mp.OrganizationID = {{ OrganizationID | sqlString }} {% endif %}\nGROUP BY\n    mp.ID,\n    mp.PersonID,\n    mp.OrganizationID,\n    p.DisplayName,\n    mp.MemberNumber,\n    p.Title,\n    mp.Segment,\n    mp.City,\n    mp.State\nORDER BY\n    TotalActivity DESC,\n    p.DisplayName ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
