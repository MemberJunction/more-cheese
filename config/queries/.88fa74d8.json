{
  "fields": {
    "Name": "Organization Member Activity Ranking",
    "CategoryID": "E0B2973E-C99C-4C74-90D7-81035270ECD7",
    "Description": "Aggregates member count, event registrations, course enrollments, and combined activity across member employees for each organization. Returns organizations meeting a minimum member threshold, sorted by activity levels.",
    "SQL": "SELECT\n    o.ID AS OrganizationID,\n    o.Name AS OrganizationName,\n    o.OrganizationType,\n    o.PrimaryAddressCity AS City,\n    o.PrimaryAddressState AS State,\n    o.PrimaryAddressCountry AS Country,\n    COUNT(DISTINCT mp.PersonID) AS MemberCount,\n    COUNT(DISTINCT er.ID) AS EventCount,\n    COUNT(DISTINCT ce.ID) AS CourseCount,\n    (COUNT(DISTINCT er.ID) + COUNT(DISTINCT ce.ID)) AS TotalActivity,\n    o.[Status]\nFROM\n    [__mj_BizAppsCommon].[vwOrganizations] o\n    INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON mp.OrganizationID = o.ID\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON er.PersonID = mp.PersonID\n    LEFT JOIN [morecheese_learning].[vwCourseEnrollments] ce ON ce.PersonID = mp.PersonID\nGROUP BY\n    o.ID,\n    o.Name,\n    o.OrganizationType,\n    o.PrimaryAddressCity,\n    o.PrimaryAddressState,\n    o.PrimaryAddressCountry,\n    o.[Status]\nHAVING\n    COUNT(DISTINCT mp.PersonID) >= {{ MinMemberCount | sqlNumber }}\nORDER BY\n    TotalActivity DESC,\n    MemberCount DESC,\n    OrganizationName ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
