    "Name": "Monthly Revenue and Invoice Count By Year",
    "CategoryID": "FD4C8862-E63F-4509-B702-62D345521487",
    "Description": "Aggregates total revenue and invoice counts by month for a specified year. Filters for orders with 'Confirmed' or 'Posted' status.",
    "SQL": "SELECT\n    YEAR([OrderDate]) AS [OrderYear],\n    MONTH([OrderDate]) AS [OrderMonth],\n    SUM([TotalGross]) AS [TotalRevenue],\n    COUNT([ID]) AS [InvoiceCount]\nFROM\n    [__mj_BizAppsOrders].[vwOrderHeaders]\nWHERE\n    YEAR([OrderDate]) = {{ TargetYear | sqlNumber }}\n    AND [Status] IN ('Confirmed', 'Posted')\nGROUP BY\n    YEAR([OrderDate]),\n    MONTH([OrderDate])\nORDER BY\n    [OrderMonth] ASC",
