{
  "fields": {
    "Name": "Monthly KPI Breakdown By Category",
    "CategoryID": "E176AAB1-2EDF-4FFF-9EA0-85AB7E0CF008",
    "Description": "Calculates the categorical and compositional distribution of factors for a selected KPI and calendar month. Supports Retention (by reason/tier), Event Attendance (by type), Course Completion (by status), and Revenue (by type/segment).",
    "SQL": "WITH\n    RawData AS (\n        -- Retention: Lapsed/Cancelled members grouped by Reason or Tier\n        SELECT\n            'Retention' AS MetricKey,\n            FORMAT(EndDate, 'yyyy-MM') AS YearMonth,\n            COALESCE(CancellationReason, MembershipTier) AS CategoryCode,\n            COALESCE(CancellationReason, MembershipTier) AS CategoryName,\n            1 AS RecordCount,\n            0 AS TotalAmount\n        FROM\n            [morecheese_members].[vwMembershipPeriods]\n        WHERE\n            [Status] IN ('Lapsed', 'Cancelled')\n        UNION ALL\n        -- Event Attendance: Registrations grouped by Event Type\n        SELECT\n            'EventAttendance' AS MetricKey,\n            FORMAT(e.EventDate, 'yyyy-MM') AS YearMonth,\n            e.EventType AS CategoryCode,\n            e.EventType AS CategoryName,\n            1 AS RecordCount,\n            0 AS TotalAmount\n        FROM\n            [morecheese_events].[vwEventRegistrations] er\n            JOIN [morecheese_events].[vwEvents] e ON er.EventID = e.ID\n        UNION ALL\n        -- Course Completion: Enrollments grouped by Status\n        SELECT\n            'CourseCompletion' AS MetricKey,\n            FORMAT(EnrolledOn, 'yyyy-MM') AS YearMonth,\n            [Status] AS CategoryCode,\n            [Status] AS CategoryName,\n            1 AS RecordCount,\n            0 AS TotalAmount\n        FROM\n            [morecheese_learning].[vwCourseEnrollments]\n        UNION ALL\n        -- Revenue: Orders grouped by OrderType and Member Segment\n        SELECT\n            'Revenue' AS MetricKey,\n            FORMAT(o.OrderDate, 'yyyy-MM') AS YearMonth,\n            CONCAT(o.OrderType, ' - ', m.Segment) AS CategoryCode,\n            CONCAT(o.OrderType, ' (', m.Segment, ')') AS CategoryName,\n            1 AS RecordCount,\n            o.TotalGross AS TotalAmount\n        FROM\n            [__mj_BizAppsOrders].[vwOrderHeaders] o\n            LEFT JOIN [morecheese_members].[vwMemberProfiles] m ON o.BillToPersonID = m.PersonID\n        WHERE\n            o.[Status] = 'Confirmed'\n    ),\n    FilteredData AS (\n        SELECT\n            *\n        FROM\n            RawData\n        WHERE\n            MetricKey = {{ MetricKey | sqlString }}\n            AND YearMonth = {{ YearMonth | sqlString }}\n    ),\n    Totals AS (\n        SELECT\n            SUM(RecordCount) AS GrandTotalCount,\n            SUM(TotalAmount) AS GrandTotalAmount\n        FROM\n            FilteredData\n    )\nSELECT\n    f.MetricKey,\n    f.YearMonth,\n    f.CategoryCode,\n    f.CategoryName,\n    SUM(f.RecordCount) AS RecordCount,\n    SUM(f.TotalAmount) AS TotalAmount,\n    CAST(\n        CASE\n            WHEN f.MetricKey = 'Revenue' THEN SUM(f.TotalAmount) * 100.0 / NULLIF(t.GrandTotalAmount, 0)\n            ELSE SUM(f.RecordCount) * 100.0 / NULLIF(t.GrandTotalCount, 0)\n        END AS DECIMAL(18, 2)\n    ) AS PercentageOfTotal,\n    CONCAT(\n        'MetricKey=',\n        f.MetricKey,\n        '&YearMonth=',\n        f.YearMonth,\n        '&CategoryCode=',\n        f.CategoryCode\n    ) AS FilterPredicate\nFROM\n    FilteredData f\n    CROSS JOIN Totals t\nGROUP BY\n    f.MetricKey,\n    f.YearMonth,\n    f.CategoryCode,\n    f.CategoryName,\n    t.GrandTotalCount,\n    t.GrandTotalAmount\nORDER BY\n    PercentageOfTotal DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
