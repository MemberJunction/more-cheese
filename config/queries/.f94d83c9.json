{
  "fields": {
    "Name": "Quarterly Course Completion Rates (1)",
    "CategoryID": "972753F6-0627-41DB-8A68-1B829F8DF53C",
    "Description": "Calculates longitudinal quarterly completion metrics and rates for all courses or a specific course, including enrollment totals, status breakdowns, and completion percentages.",
    "SQL": "SELECT\n    c.ID AS CourseID,\n    c.[Name] AS CourseName,\n    YEAR(ce.EnrolledOn) AS EnrollmentYear,\n    DATEPART(QUARTER, ce.EnrolledOn) AS EnrollmentQuarter,\n    CONCAT(\n        YEAR(ce.EnrolledOn),\n        '-Q',\n        DATEPART(QUARTER, ce.EnrolledOn)\n    ) AS QuarterLabel,\n    COUNT(ce.ID) AS TotalEnrolled,\n    COUNT(\n        CASE\n            WHEN ce.[Status] = 'Completed' THEN 1\n        END\n    ) AS CompletedCount,\n    COUNT(\n        CASE\n            WHEN ce.[Status] = 'InProgress' THEN 1\n        END\n    ) AS InProgressCount,\n    COUNT(\n        CASE\n            WHEN ce.[Status] = 'Dropped' THEN 1\n        END\n    ) AS DroppedCount,\n    CAST(\n        ROUND(\n            COUNT(\n                CASE\n                    WHEN ce.[Status] = 'Completed' THEN 1.0\n                END\n            ) * 100.0 / NULLIF(COUNT(ce.ID), 0),\n            2\n        ) AS decimal(5, 2)\n    ) AS CompletionRatePct\nFROM\n    [morecheese_learning].[vwCourses] c\n    INNER JOIN [morecheese_learning].[vwCourseEnrollments] ce ON c.ID = ce.CourseID\nWHERE\n    1 = 1 {% if CourseID %}\n    AND c.ID = {{ CourseID | sqlString }} {% endif %} {% if StartDate %}\n    AND ce.EnrolledOn >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND ce.EnrolledOn <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    c.ID,\n    c.[Name],\n    YEAR(ce.EnrolledOn),\n    DATEPART(QUARTER, ce.EnrolledOn)\nORDER BY\n    CourseName ASC,\n    EnrollmentYear ASC,\n    EnrollmentQuarter ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
