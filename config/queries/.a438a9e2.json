{
  "fields": {
    "Name": "Top Courses By Total Enrollment",
    "CategoryID": "44D30D65-E0DC-4F70-984E-06E5041756F0",
    "Description": "Calculates total enrollment counts per course to rank the most popular learning offerings. Includes optional filters for enrollment status and course start date.",
    "SQL": "SELECT\n    c.ID AS CourseID,\n    c.Name AS CourseName,\n    COUNT(e.ID) AS TotalEnrollments\nFROM\n    [morecheese_learning].[vwCourses] c\n    INNER JOIN [morecheese_learning].[vwCourseEnrollments] e ON c.ID = e.CourseID\nWHERE\n    1 = 1 {% if EnrollStatus and EnrollStatus.length > 0 %}\n    AND e.[Status] IN {{ EnrollStatus | sqlIn }} {% endif %} {% if MinStartDate %}\n    AND c.StartDate >= {{ MinStartDate | sqlDate }} {% endif %}\nGROUP BY\n    c.ID,\n    c.Name\nORDER BY\n    TotalEnrollments DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
