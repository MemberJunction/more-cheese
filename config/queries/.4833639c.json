{
  "fields": {
    "Name": "Total Revenue by Product Category",
    "CategoryID": "FD4C8862-E63F-4509-B702-62D345521487",
    "Description": "Aggregates total net revenue, gross revenue, line transaction counts, and distinct order counts grouped by product category for confirmed sales orders within an optional date range.",
    "SQL": "SELECT\n    pc.ID AS CategoryID,\n    pc.Name AS CategoryName,\n    SUM(ol.LineTotalNet) AS TotalNetRevenue,\n    SUM(ol.LineTotalGross) AS TotalGrossRevenue,\n    COUNT(ol.ID) AS TransactionCount,\n    COUNT(DISTINCT oh.ID) AS OrderCount\nFROM\n    [__mj_BizAppsOrders].[vwOrderLines] ol\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON ol.OrderHeaderID = oh.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProducts] p ON ol.ProductID = p.ID\n    INNER JOIN [__mj_BizAppsOrders].[vwProductCategories] pc ON p.ProductCategoryID = pc.ID\nWHERE\n    oh.[Status] IN ('Confirmed', 'Posted', 'Fulfilled')\n    AND ol.IsRollupParent = 0\n    AND pc.IsActive = 1 {% if StartDate %}\n    AND oh.OrderDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND oh.OrderDate <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    pc.ID,\n    pc.Name\nORDER BY\n    TotalNetRevenue DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
