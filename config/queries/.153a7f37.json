{
  "fields": {
    "Name": "Chapter Member Activity Log By Quarter",
    "CategoryID": "F8B084A3-3D45-4896-98B7-FEE5736FA71F",
    "Description": "Returns a unified, granular activity log of all events attended, courses completed, and committee meetings attended by members affiliated with a specific chapter in a given quarter.",
    "SQL": "SELECT\n    mp.OrganizationID,\n    YEAR(Activity.ActivityDate) AS [Year],\n    DATEPART(QUARTER, Activity.ActivityDate) AS QuarterNumber,\n    Activity.PersonID,\n    Activity.MemberName,\n    Activity.ActivityType,\n    Activity.ItemID,\n    Activity.ItemTitle,\n    Activity.ActivityDate,\n    Activity.OutcomeStatus\nFROM\n    (\n        -- 1) Event Registrations (Attended=1)\n        SELECT\n            er.PersonID,\n            er.Person AS MemberName,\n            'Event' AS ActivityType,\n            er.EventID AS ItemID,\n            er.Event AS ItemTitle,\n            e.EventDate AS ActivityDate,\n            'Attended' AS OutcomeStatus\n        FROM\n            [morecheese_events].[vwEventRegistrations] er\n            INNER JOIN [morecheese_events].[vwEvents] e ON er.EventID = e.ID\n        WHERE\n            er.Attended = 1\n        UNION ALL\n        -- 2) Course Enrollments (Status='Completed')\n        SELECT\n            ce.PersonID,\n            ce.Person AS MemberName,\n            'Course' AS ActivityType,\n            ce.CourseID AS ItemID,\n            ce.Course AS ItemTitle,\n            ce.CompletedOn AS ActivityDate,\n            ce.Status AS OutcomeStatus\n        FROM\n            [morecheese_learning].[vwCourseEnrollments] ce\n        WHERE\n            ce.Status = 'Completed'\n        UNION ALL\n        -- 3) Committee Attendances (AttendanceStatus='Present')\n        SELECT\n            ca.PersonID,\n            ca.Person AS MemberName,\n            'Committee' AS ActivityType,\n            m.CommitteeID AS ItemID,\n            m.Name AS ItemTitle,\n            CAST(m.StartDateTime AS DATE) AS ActivityDate,\n            ca.AttendanceStatus AS OutcomeStatus\n        FROM\n            [__mj_BizAppsCommittees].[vwAttendances] ca\n            INNER JOIN [__mj_BizAppsCommittees].[vwMeetings] m ON ca.MeetingID = m.ID\n        WHERE\n            ca.AttendanceStatus = 'Present'\n    ) AS Activity\n    INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON Activity.PersonID = mp.PersonID\nWHERE\n    mp.OrganizationID = {{ OrganizationID | sqlString }}\n    AND YEAR(Activity.ActivityDate) = {{ Year | sqlNumber }}\n    AND DATEPART(QUARTER, Activity.ActivityDate) = {{ QuarterNumber | sqlNumber }} {% if ActivityType %}\n    AND Activity.ActivityType = {{ ActivityType | sqlString }} {% endif %}\nORDER BY\n    Activity.ActivityDate DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
