{
  "fields": {
    "Name": "Monthly Revenue and Collections by Year",
    "CategoryID": "FD4C8862-E63F-4509-B702-62D345521487",
    "Description": "Aggregates monthly gross confirmed revenue, cash collections, open balance, and transaction count for the current and prior calendar years. Supports optional filtering by OrderType and CompanyID.",
    "SQL": "SELECT\n    YEAR(OrderDate) AS CalendarYear,\n    MONTH(OrderDate) AS CalendarMonth,\n    DATENAME(MONTH, OrderDate) AS MonthName,\n    SUM(TotalGross) AS TotalGrossRevenue,\n    COUNT(ID) AS InvoiceCount,\n    SUM(AmountPaid) AS TotalPaid,\n    SUM(Balance) AS TotalOpenBalance\nFROM\n    [__mj_BizAppsOrders].[vwOrderHeaders]\nWHERE\n    [Status] IN ('Confirmed', 'Posted')\n    AND YEAR(OrderDate) IN {{ Years | sqlIn }} {% if OrderTypes and OrderTypes.length > 0 %}\n    AND OrderType IN {{ OrderTypes | sqlIn }} {% endif %} {% if CompanyID %}\n    AND CompanyID = {{ CompanyID | sqlString }} {% endif %}\nGROUP BY\n    YEAR(OrderDate),\n    MONTH(OrderDate),\n    DATENAME(MONTH, OrderDate)\nORDER BY\n    CalendarYear DESC,\n    CalendarMonth ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
