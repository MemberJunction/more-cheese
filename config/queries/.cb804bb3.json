{
  "fields": {
    "Name": "Event Attendance Performance Summary",
    "CategoryID": "28BA117D-4EA3-4F21-9247-EEDB8EE66E2F",
    "Description": "Calculates event-level attendance performance metrics including total registrations, total attendees, and attendance percentage. Can be filtered by event type and date range.",
    "SQL": "SELECT\n    e.ID AS EventID,\n    e.EventKey,\n    e.Name AS EventName,\n    e.EventType,\n    e.EventDate,\n    e.IsVirtual,\n    e.IsPaid,\n    e.City,\n    e.State,\n    YEAR(e.EventDate) AS [Year],\n    DATEPART(QUARTER, e.EventDate) AS [Quarter],\n    CONCAT('Q', DATEPART(QUARTER, e.EventDate)) AS QuarterLabel,\n    COUNT(er.ID) AS TotalRegistrations,\n    COUNT(\n        CASE\n            WHEN er.Attended = 1 THEN 1\n        END\n    ) AS TotalAttendees,\n    CAST(\n        COUNT(\n            CASE\n                WHEN er.Attended = 1 THEN 1\n            END\n        ) * 100.0 / NULLIF(COUNT(er.ID), 0) AS DECIMAL(5, 2)\n    ) AS AttendanceRate\nFROM\n    [morecheese_events].[vwEvents] e\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON e.ID = er.EventID\nWHERE\n    1 = 1 {% if EventTypes and EventTypes.length > 0 %}\n    AND e.EventType IN {{ EventTypes | sqlIn }} {% endif %} {% if StartDate %}\n    AND e.EventDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND e.EventDate <= {{ EndDate | sqlDate }} {% endif %}\nGROUP BY\n    e.ID,\n    e.EventKey,\n    e.Name,\n    e.EventType,\n    e.EventDate,\n    e.IsVirtual,\n    e.IsPaid,\n    e.City,\n    e.State,\n    YEAR(e.EventDate),\n    DATEPART(QUARTER, e.EventDate)\nORDER BY\n    e.EventDate DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
