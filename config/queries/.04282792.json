{
  "fields": {
    "Name": "Chapter Engagement Overview",
    "CategoryID": "4D499ED2-94EF-42BD-A04E-5621EAA89B44",
    "Description": "Aggregates member count, event registrations, attendance metrics, and average member tenure across chapters (organizations) and regions.",
    "SQL": "SELECT\n    o.ID AS OrganizationID,\n    o.Name AS ChapterName,\n    mp.Region,\n    o.PrimaryAddressState,\n    o.PrimaryAddressCountry,\n    COUNT(DISTINCT mp.PersonID) AS TotalMembers,\n    COUNT(er.ID) AS TotalRegistrations,\n    SUM(\n        CASE\n            WHEN er.Attended = 1 THEN 1\n            ELSE 0\n        END\n    ) AS TotalAttended,\n    CAST(\n        SUM(\n            CASE\n                WHEN er.Attended = 1 THEN 100.0\n                ELSE 0\n            END\n        ) / NULLIF(COUNT(er.ID), 0) AS DECIMAL(5, 1)\n    ) AS AttendanceRate,\n    AVG(DATEDIFF(day, mp.JoinDate, GETUTCDATE()) / 365.25) AS AvgTenureYears\nFROM\n    [__mj_BizAppsCommon].[vwOrganizations] o\n    INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON o.ID = mp.OrganizationID\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON mp.PersonID = er.PersonID\nWHERE\n    o.[Status] = {{ Status | sqlString }} {% if Regions and Regions.length > 0 %}\n    AND mp.Region IN {{ Regions | sqlIn }} {% endif %}\nGROUP BY\n    o.ID,\n    o.Name,\n    mp.Region,\n    o.PrimaryAddressState,\n    o.PrimaryAddressCountry",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
