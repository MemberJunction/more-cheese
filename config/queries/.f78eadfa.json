{
  "fields": {
    "Name": "Top Active Members by Engagement Score",
    "CategoryID": "8D4F7766-B115-4B87-AF11-891AF5A265ED",
    "Description": "Ranks chapter members by a composite multi-channel engagement score based on event attendance, course completions, and advocacy actions.",
    "SQL": "WITH\n    EventStats AS (\n        SELECT\n            PersonID,\n            SUM(\n                CASE\n                    WHEN Attended = 1 THEN 1\n                    ELSE 0\n                END\n            ) AS EventsAttended\n        FROM\n            [morecheese_events].[vwEventRegistrations]\n        GROUP BY\n            PersonID\n    ),\n    CourseStats AS (\n        SELECT\n            PersonID,\n            SUM(\n                CASE\n                    WHEN [Status] = 'Completed' THEN 1\n                    ELSE 0\n                END\n            ) AS CoursesCompleted\n        FROM\n            [morecheese_learning].[vwCourseEnrollments]\n        GROUP BY\n            PersonID\n    ),\n    AdvocacyStats AS (\n        SELECT\n            PersonID,\n            COUNT(DISTINCT ID) AS AdvocacyActionsCount\n        FROM\n            [morecheese_members].[vwAdvocacyActions]\n        GROUP BY\n            PersonID\n    )\nSELECT\n    mp.ID AS MemberProfileID,\n    mp.PersonID,\n    mp.OrganizationID,\n    mp.Organization AS ChapterName,\n    p.DisplayName AS MemberName,\n    mp.MemberNumber,\n    mp.Segment,\n    mp.Region,\n    mp.City,\n    mp.State,\n    mp.JoinDate,\n    ISNULL(es.EventsAttended, 0) AS EventsAttended,\n    ISNULL(cs.CoursesCompleted, 0) AS CoursesCompleted,\n    ISNULL(asub.AdvocacyActionsCount, 0) AS AdvocacyActionsCount,\n    (ISNULL(es.EventsAttended, 0) * 5) + (ISNULL(cs.CoursesCompleted, 0) * 4) + (ISNULL(asub.AdvocacyActionsCount, 0) * 3) AS CompositeScore\nFROM\n    [morecheese_members].[vwMemberProfiles] AS mp\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] AS p ON mp.PersonID = p.ID\n    LEFT JOIN EventStats es ON mp.PersonID = es.PersonID\n    LEFT JOIN CourseStats cs ON mp.PersonID = cs.PersonID\n    LEFT JOIN AdvocacyStats asub ON mp.PersonID = asub.PersonID\nWHERE\n    1 = 1 {% if Segment %}\n    AND mp.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n    AND mp.Region = {{ Region | sqlString }} {% endif %}\nORDER BY\n    CompositeScore DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
