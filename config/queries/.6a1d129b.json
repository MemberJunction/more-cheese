{
  "fields": {
    "Name": "Monthly Email Engagement Metrics",
    "CategoryID": "271A5166-6C06-4DD5-96D3-0BB80BF1E8E6",
    "Description": "Aggregates monthly outbound email engagement metrics (Sent, Delivered, Bounced, Opens, Clicks) and calculates performance ratios. Uses Activity Outcome and JSON Details for tracking.",
    "SQL": "WITH\n    BaseData AS (\n        SELECT\n            a.StartedAt,\n            a.Outcome,\n            a.Status,\n            a.Details\n        FROM\n            [__mj_BizAppsCommon].[vwActivities] a\n            INNER JOIN [__mj_BizAppsCommon].[vwActivityTypes] at ON a.ActivityTypeID = at.ID\n        WHERE\n            at.Code = 'Email'\n            AND a.Direction = 'Outbound' {% if StartDate %}\n            AND a.StartedAt >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n            AND a.StartedAt <= {{ EndDate | sqlDate }} {% endif %}\n    ),\n    MonthlyAgg AS (\n        SELECT\n            FORMAT(StartedAt, 'yyyy-MM') AS YearMonth,\n            FORMAT(StartedAt, 'MMM yyyy') AS MonthLabel,\n            YEAR(StartedAt) AS YearNum,\n            MONTH(StartedAt) AS MonthNum,\n            COUNT(*) AS TotalSent,\n            SUM(\n                CASE\n                    WHEN ISNULL(Outcome, '') <> 'Bounced'\n                    AND Status <> 'Failed' THEN 1\n                    ELSE 0\n                END\n            ) AS TotalDelivered,\n            SUM(\n                CASE\n                    WHEN Outcome = 'Bounced' THEN 1\n                    ELSE 0\n                END\n            ) AS TotalBounced,\n            SUM(\n                CASE\n                    WHEN Outcome IN ('Opened', 'Clicked', 'Interested')\n                    OR ISNULL(\n                        TRY_CAST(JSON_VALUE(Details, '$.UniqueOpens') AS INT),\n                        0\n                    ) > 0 THEN 1\n                    ELSE 0\n                END\n            ) AS TotalOpened,\n            SUM(\n                CASE\n                    WHEN Outcome = 'Clicked'\n                    OR ISNULL(\n                        TRY_CAST(JSON_VALUE(Details, '$.UniqueClicks') AS INT),\n                        0\n                    ) > 0 THEN 1\n                    ELSE 0\n                END\n            ) AS TotalClicked\n        FROM\n            BaseData\n        GROUP BY\n            FORMAT(StartedAt, 'yyyy-MM'),\n            FORMAT(StartedAt, 'MMM yyyy'),\n            YEAR(StartedAt),\n            MONTH(StartedAt)\n    )\nSELECT\n    YearMonth,\n    MonthLabel,\n    YearNum,\n    MonthNum,\n    TotalSent,\n    TotalDelivered,\n    TotalBounced,\n    TotalOpened,\n    TotalClicked,\n    CAST(\n        TotalOpened * 100.0 / NULLIF(TotalDelivered, 0) AS DECIMAL(18, 2)\n    ) AS OpenRatePercent,\n    CAST(\n        TotalClicked * 100.0 / NULLIF(TotalDelivered, 0) AS DECIMAL(18, 2)\n    ) AS ClickThroughRatePercent,\n    CAST(\n        TotalClicked * 100.0 / NULLIF(TotalOpened, 0) AS DECIMAL(18, 2)\n    ) AS ClickToOpenRatePercent\nFROM\n    MonthlyAgg\nORDER BY\n    YearNum ASC,\n    MonthNum ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
