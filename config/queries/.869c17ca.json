{
  "fields": {
    "Name": "Event Revenue and Registration Summary",
    "CategoryID": "7333DBDC-381E-476E-84E9-357EA0EAFE25",
    "Description": "Aggregates revenue, registration volume, and attendance performance per event. Supports filtering by date range, event type, and status.",
    "SQL": "WITH\n    EventRevenue AS (\n        SELECT\n            e.ID AS EventID,\n            COALESCE(SUM(ol.LineTotalNet), 0) AS TotalRevenue\n        FROM\n            [morecheese_events].[vwEvents] e\n            LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON e.ID = er.EventID\n            LEFT JOIN [__mj_BizAppsOrders].[vwOrderLines] ol ON ol.OrderHeader LIKE '%' + er.RegKey + '%'\n        GROUP BY\n            e.ID\n    )\nSELECT\n    e.ID AS EventID,\n    e.Name AS EventName,\n    e.EventType,\n    e.EventDate,\n    e.IsVirtual,\n    e.IsPaid,\n    e.City,\n    e.State,\n    COUNT(DISTINCT er.ID) AS RegistrationCount,\n    COUNT(\n        DISTINCT CASE\n            WHEN er.Attended = 1 THEN er.ID\n        END\n    ) AS AttendedCount,\n    rev.TotalRevenue,\n    CAST(\n        rev.TotalRevenue * 1.0 / NULLIF(COUNT(DISTINCT er.ID), 0) AS DECIMAL(18, 2)\n    ) AS AvgRevenuePerRegistrant\nFROM\n    [morecheese_events].[vwEvents] e\n    LEFT JOIN [morecheese_events].[vwEventRegistrations] er ON e.ID = er.EventID\n    LEFT JOIN EventRevenue rev ON e.ID = rev.EventID\nWHERE\n    1 = 1 {% if EventTypes and EventTypes.length > 0 %}\n    AND e.EventType IN {{ EventTypes | sqlIn }} {% endif %} {% if StartDate %}\n    AND e.EventDate >= {{ StartDate | sqlDate }} {% endif %} {% if EndDate %}\n    AND e.EventDate <= {{ EndDate | sqlDate }} {% endif %} {% if IsPaid != null %}\n    AND e.IsPaid = {{ IsPaid | sqlNumber }} {% endif %} {% if IsVirtual != null %}\n    AND e.IsVirtual = {{ IsVirtual | sqlNumber }} {% endif %}\nGROUP BY\n    e.ID,\n    e.Name,\n    e.EventType,\n    e.EventDate,\n    e.IsVirtual,\n    e.IsPaid,\n    e.City,\n    e.State,\n    rev.TotalRevenue\nORDER BY\n    rev.TotalRevenue DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
