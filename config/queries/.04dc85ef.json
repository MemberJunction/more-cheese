{
  "fields": {
    "Name": "Annual Membership and Revenue Trajectory",
    "CategoryID": "16DC714B-8648-47B7-94D4-481CF18195AE",
    "Description": "Aggregates annual trajectory metrics combining active membership counts and gross realized revenue. Active member count is calculated from membership periods with 'Active' or 'Renewed' status during the calendar year. Gross revenue is summed from 'Confirmed' or 'Posted' orders. Includes Average Revenue Per Member (ARPU).",
    "SQL": "WITH\n    Years AS (\n        SELECT\n            {{ StartYear | sqlNumber }} AS [Year]\n        UNION ALL\n        SELECT\n            [Year] + 1\n        FROM\n            Years\n        WHERE\n            [Year] < {{ EndYear | sqlNumber }}\n    ),\n    MembershipStats AS (\n        SELECT\n            y.[Year],\n            COUNT(DISTINCT mp.PersonID) AS MemberCount\n        FROM\n            Years y\n            LEFT JOIN [morecheese_members].[vwMembershipPeriods] mp ON y.[Year] BETWEEN YEAR(mp.StartDate) AND YEAR(mp.EndDate)\n            AND mp.[Status] IN ('Active', 'Renewed')\n        GROUP BY\n            y.[Year]\n    ),\n    OrderStats AS (\n        SELECT\n            YEAR(oh.OrderDate) AS [Year],\n            SUM(oh.TotalGross) AS GrossRevenue,\n            COUNT(oh.ID) AS OrderCount\n        FROM\n            [__mj_BizAppsOrders].[vwOrderHeaders] oh\n        WHERE\n            oh.[Status] IN ('Confirmed', 'Posted')\n            AND YEAR(oh.OrderDate) BETWEEN {{ StartYear | sqlNumber }} AND {{ EndYear | sqlNumber }}\n        GROUP BY\n            YEAR(oh.OrderDate)\n    )\nSELECT\n    y.[Year],\n    ISNULL(ms.MemberCount, 0) AS MemberCount,\n    ISNULL(os.GrossRevenue, 0) AS GrossRevenue,\n    ISNULL(os.OrderCount, 0) AS OrderCount,\n    CAST(\n        CASE\n            WHEN ISNULL(ms.MemberCount, 0) = 0 THEN 0\n            ELSE ISNULL(os.GrossRevenue, 0) * 1.0 / ms.MemberCount\n        END AS DECIMAL(18, 2)\n    ) AS AvgRevenuePerMember\nFROM\n    Years y\n    LEFT JOIN MembershipStats ms ON y.[Year] = ms.[Year]\n    LEFT JOIN OrderStats os ON y.[Year] = os.[Year]\nORDER BY\n    y.[Year] ASC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
