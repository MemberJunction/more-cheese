{
  "fields": {
    "Name": "Quarterly Organization Engagement Summary",
    "CategoryID": "E0B2973E-C99C-4C74-90D7-81035270ECD7",
    "Description": "Calculates quarterly aggregate engagement metrics and a composite engagement index (0-100) for organizations over an 8-quarter trailing period. Includes event attendance, course completions, and committee participation.",
    "SQL": "WITH\n    Quarters AS (\n        SELECT\n            2024 AS [Year],\n            4 AS QuarterNumber,\n            '2024-Q4' AS QuarterKey,\n            'Q4 2024' AS QuarterLabel\n        UNION ALL\n        SELECT\n            2025,\n            1,\n            '2025-Q1',\n            'Q1 2025'\n        UNION ALL\n        SELECT\n            2025,\n            2,\n            '2025-Q2',\n            'Q2 2025'\n        UNION ALL\n        SELECT\n            2025,\n            3,\n            '2025-Q3',\n            'Q3 2025'\n        UNION ALL\n        SELECT\n            2025,\n            4,\n            '2025-Q4',\n            'Q4 2025'\n        UNION ALL\n        SELECT\n            2026,\n            1,\n            '2026-Q1',\n            'Q1 2026'\n        UNION ALL\n        SELECT\n            2026,\n            2,\n            '2026-Q2',\n            'Q2 2026'\n        UNION ALL\n        SELECT\n            2026,\n            3,\n            '2026-Q3',\n            'Q3 2026'\n    ),\n    OrgQuarters AS (\n        SELECT\n            o.ID AS OrganizationID,\n            o.Name AS OrganizationName,\n            o.PrimaryAddressCity,\n            o.PrimaryAddressState,\n            q.[Year],\n            q.QuarterNumber,\n            q.QuarterKey,\n            q.QuarterLabel\n        FROM\n            [__mj_BizAppsCommon].[vwOrganizations] o\n            CROSS JOIN Quarters q\n        WHERE\n            o.[Status] = 'Active'\n    ),\n    MemberStats AS (\n        SELECT\n            mp.OrganizationID,\n            COUNT(DISTINCT mp.PersonID) AS ActiveMemberCount\n        FROM\n            [morecheese_members].[vwMemberProfiles] mp\n        GROUP BY\n            mp.OrganizationID\n    ),\n    EventStats AS (\n        SELECT\n            mp.OrganizationID,\n            CONCAT(\n                YEAR(e.EventDate),\n                '-Q',\n                DATEPART(QUARTER, e.EventDate)\n            ) AS QuarterKey,\n            COUNT(*) AS EventsAttendedCount\n        FROM\n            [morecheese_events].[vwEventRegistrations] er\n            JOIN [morecheese_events].[vwEvents] e ON er.EventID = e.ID\n            JOIN [morecheese_members].[vwMemberProfiles] mp ON er.PersonID = mp.PersonID\n        WHERE\n            er.Attended = 1\n        GROUP BY\n            mp.OrganizationID,\n            YEAR(e.EventDate),\n            DATEPART(QUARTER, e.EventDate)\n    ),\n    CourseStats AS (\n        SELECT\n            mp.OrganizationID,\n            CONCAT(\n                YEAR(ce.CompletedOn),\n                '-Q',\n                DATEPART(QUARTER, ce.CompletedOn)\n            ) AS QuarterKey,\n            COUNT(*) AS CoursesCompletedCount\n        FROM\n            [morecheese_learning].[vwCourseEnrollments] ce\n            JOIN [morecheese_members].[vwMemberProfiles] mp ON ce.PersonID = mp.PersonID\n        WHERE\n            ce.[Status] = 'Completed'\n        GROUP BY\n            mp.OrganizationID,\n            YEAR(ce.CompletedOn),\n            DATEPART(QUARTER, ce.CompletedOn)\n    ),\n    CommitteeStats AS (\n        SELECT\n            mp.OrganizationID,\n            CONCAT(\n                YEAR(m.StartDateTime),\n                '-Q',\n                DATEPART(QUARTER, m.StartDateTime)\n            ) AS QuarterKey,\n            COUNT(*) AS CommitteeAttendancesCount\n        FROM\n            [__mj_BizAppsCommittees].[vwAttendances] a\n            JOIN [__mj_BizAppsCommittees].[vwMeetings] m ON a.MeetingID = m.ID\n            JOIN [morecheese_members].[vwMemberProfiles] mp ON a.PersonID = mp.PersonID\n        WHERE\n            a.AttendanceStatus = 'Present'\n        GROUP BY\n            mp.OrganizationID,\n            YEAR(m.StartDateTime),\n            DATEPART(QUARTER, m.StartDateTime)\n    )\nSELECT\n    TOP 20 oq.OrganizationID,\n    oq.OrganizationName,\n    oq.PrimaryAddressCity,\n    oq.PrimaryAddressState,\n    oq.QuarterKey,\n    oq.QuarterLabel,\n    oq.[Year],\n    oq.QuarterNumber,\n    ISNULL(es.EventsAttendedCount, 0) AS EventsAttendedCount,\n    ISNULL(cs.CoursesCompletedCount, 0) AS CoursesCompletedCount,\n    ISNULL(coms.CommitteeAttendancesCount, 0) AS CommitteeAttendancesCount,\n    (\n        ISNULL(es.EventsAttendedCount, 0) + ISNULL(cs.CoursesCompletedCount, 0) + ISNULL(coms.CommitteeAttendancesCount, 0)\n    ) AS TotalActivities,\n    ISNULL(ms.ActiveMemberCount, 0) AS ActiveMemberCount,\n    CAST(\n        IIF(\n            ROUND(\n                (\n                    ISNULL(es.EventsAttendedCount, 0) * 0.45 + ISNULL(cs.CoursesCompletedCount, 0) * 0.35 + ISNULL(coms.CommitteeAttendancesCount, 0) * 0.20\n                ) / NULLIF(CAST(ms.ActiveMemberCount AS FLOAT), 0) * 20,\n                0\n            ) > 100,\n            100,\n            ROUND(\n                (\n                    ISNULL(es.EventsAttendedCount, 0) * 0.45 + ISNULL(cs.CoursesCompletedCount, 0) * 0.35 + ISNULL(coms.CommitteeAttendancesCount, 0) * 0.20\n                ) / NULLIF(CAST(ms.ActiveMemberCount AS FLOAT), 0) * 20,\n                0\n            )\n        ) AS INT\n    ) AS EngagementScore,\n    CASE\n        WHEN (\n            ISNULL(es.EventsAttendedCount, 0) * 0.45 + ISNULL(cs.CoursesCompletedCount, 0) * 0.35 + ISNULL(coms.CommitteeAttendancesCount, 0) * 0.20\n        ) / NULLIF(CAST(ms.ActiveMemberCount AS FLOAT), 0) * 20 >= 80 THEN 'Excellent'\n        WHEN (\n            ISNULL(es.EventsAttendedCount, 0) * 0.45 + ISNULL(cs.CoursesCompletedCount, 0) * 0.35 + ISNULL(coms.CommitteeAttendancesCount, 0) * 0.20\n        ) / NULLIF(CAST(ms.ActiveMemberCount AS FLOAT), 0) * 20 >= 60 THEN 'Very Good'\n        WHEN (\n            ISNULL(es.EventsAttendedCount, 0) * 0.45 + ISNULL(cs.CoursesCompletedCount, 0) * 0.35 + ISNULL(coms.CommitteeAttendancesCount, 0) * 0.20\n        ) / NULLIF(CAST(ms.ActiveMemberCount AS FLOAT), 0) * 20 >= 40 THEN 'Good'\n        WHEN (\n            ISNULL(es.EventsAttendedCount, 0) * 0.45 + ISNULL(cs.CoursesCompletedCount, 0) * 0.35 + ISNULL(coms.CommitteeAttendancesCount, 0) * 0.20\n        ) / NULLIF(CAST(ms.ActiveMemberCount AS FLOAT), 0) * 20 >= 20 THEN 'Fair'\n        ELSE 'Low'\n    END AS EngagementTier\nFROM\n    OrgQuarters oq\n    LEFT JOIN MemberStats ms ON oq.OrganizationID = ms.OrganizationID\n    LEFT JOIN EventStats es ON oq.OrganizationID = es.OrganizationID\n    AND oq.QuarterKey = es.QuarterKey\n    LEFT JOIN CourseStats cs ON oq.OrganizationID = cs.OrganizationID\n    AND oq.QuarterKey = cs.QuarterKey\n    LEFT JOIN CommitteeStats coms ON oq.OrganizationID = coms.OrganizationID\n    AND oq.QuarterKey = coms.QuarterKey\nORDER BY\n    oq.OrganizationName,\n    oq.[Year] DESC,\n    oq.QuarterNumber DESC",
