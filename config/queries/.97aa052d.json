{
  "fields": {
    "Name": "Total Cohort Revenue by Product Category",
    "CategoryID": "299562AB-5017-4D0B-B06E-12872A0BF732",
    "Description": "Calculates revenue distribution across product types and categories for member join cohorts, supporting filters for cohort year, member segment, and region.",
    "SQL": "SELECT\n    YEAR(mp.JoinDate) AS CohortYear,\n    p.ProductCategoryID,\n    COALESCE(pc.Name, p.ProductCategory, 'Other') AS CategoryName,\n    COALESCE(p.ProductType, 'General') AS ProductType,\n    SUM(ol.LineTotalGross) AS CategoryRevenue,\n    COUNT(ol.ID) AS LineItemCount\nFROM\n    [morecheese_members].[vwMemberProfiles] mp\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderHeaders] oh ON mp.PersonID = oh.BillToPersonID\n    INNER JOIN [__mj_BizAppsOrders].[vwOrderLines] ol ON oh.ID = ol.OrderHeaderID\n    INNER JOIN [__mj_BizAppsOrders].[vwProducts] p ON ol.ProductID = p.ID\n    LEFT JOIN [__mj_BizAppsOrders].[vwProductCategories] pc ON p.ProductCategoryID = pc.ID\nWHERE\n    oh.OrderType = 'Sale'\n    AND oh.Status IN ('Confirmed', 'Posted', 'Fulfilled')\n    AND ol.IsRollupParent = 0\n    AND YEAR(mp.JoinDate) = {{ CohortYear | sqlNumber }} {% if Segment %}\n    AND mp.Segment = {{ Segment | sqlString }} {% endif %} {% if Region %}\n    AND mp.Region = {{ Region | sqlString }} {% endif %}\nGROUP BY\n    YEAR(mp.JoinDate),\n    p.ProductCategoryID,\n    COALESCE(pc.Name, p.ProductCategory, 'Other'),\n    COALESCE(p.ProductType, 'General')\nORDER BY\n    CategoryRevenue DESC",
    "Status": "Pending",
    "QualityRank": 0,
    "UsesTemplate": true,
    "AuditQueryRuns": false,
    "CacheEnabled": false,
