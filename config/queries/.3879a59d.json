    "Description": "Retrieves the comprehensive roster of all currently active members by joining Membership Periods, Member Profiles, and People. Includes member details, tier, segment, and geography. Supports filtering by MembershipTier and text search.",
    "SQL": "SELECT\n    p.ID AS PersonID,\n    mp.ID AS MemberProfileID,\n    mper.ID AS MemberPeriodID,\n    mp.MemberNumber,\n    p.DisplayName,\n    p.PrimaryEmail,\n    mp.Organization AS OrganizationName,\n    mper.MembershipTier,\n    mp.Segment,\n    mp.City,\n    mp.State,\n    mp.CountryName,\n    mp.JoinDate,\n    mper.DuesAmount,\n    mper.StartDate AS PeriodStartDate,\n    mper.EndDate AS PeriodEndDate,\n    mper.AutoRenew\nFROM\n    [morecheese_members].[vwMembershipPeriods] mper\n    INNER JOIN [morecheese_members].[vwMemberProfiles] mp ON mper.PersonID = mp.PersonID\n    INNER JOIN [__mj_BizAppsCommon].[vwPeople] p ON mper.PersonID = p.ID\nWHERE\n    mper.[Status] = 'Active' {% if MembershipTiers and MembershipTiers.length > 0 %}\n    AND mper.MembershipTier IN {{ MembershipTiers | sqlIn }} {% endif %} {% if SearchText and SearchText.length > 0 %}\n    AND (\n        mp.MemberNumber LIKE {{ SearchText | sqlLikeContains }}\n        OR p.DisplayName LIKE {{ SearchText | sqlLikeContains }}\n        OR p.PrimaryEmail LIKE {{ SearchText | sqlLikeContains }}\n        OR mp.Organization LIKE {{ SearchText | sqlLikeContains }}\n    ) {% endif %}\nORDER BY\n    p.DisplayName",
