{
  "entity": "MJ: Entity Documents",
  "filePattern": "**/.*.json",
  "pull": {
    "filePattern": ".*.json",
    "createNewFileIfNotFound": true,
    "newFileName": ".entity-documents.json",
    "appendRecordsToExistingFile": true,
    "updateExistingRecords": true,
    "mergeStrategy": "merge",
    "excludeFields": [
      "__mj_CreatedAt",
      "__mj_UpdatedAt"
    ],
    "externalizeFields": ["Template"],
    "ignoreNullFields": true,
    "ignoreVirtualFields": true
  }
}
