{
  "entity": "MJ: User Settings",
  "filePattern": "**/.*.json",
  "pull": {
    "filePattern": ".*.json",
    "createNewFileIfNotFound": true,
    "newFileName": ".user-settings.json",
    "appendRecordsToExistingFile": true,
    "updateExistingRecords": true,
    "mergeStrategy": "merge",
    "excludeFields": [
      "__mj_CreatedAt",
      "__mj_UpdatedAt",
      "__mj_DeletedAt"
    ],
    "lookupFields": {
      "UserID": {
        "entity": "MJ: Users",
        "field": "Email"
      }
    },
    "ignoreVirtualFields": true
  }
}