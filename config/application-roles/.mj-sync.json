{
  "entity": "MJ: Application Roles",
  "filePattern": "**/.*.json",
  "pull": {
    "filePattern": ".*.json",
    "createNewFileIfNotFound": true,
    "newFileName": ".application-roles.json",
    "updateExistingRecords": true,
    "mergeStrategy": "merge",
    "excludeFields": [
      "__mj_CreatedAt",
      "__mj_UpdatedAt",
      "__mj_DeletedAt"
    ],
    "lookupFields": {
      "ApplicationID": {
        "entity": "MJ: Applications",
        "field": "Name"
      },
      "RoleID": {
        "entity": "MJ: Roles",
        "field": "Name"
      }
    },
    "ignoreVirtualFields": true
  }
}
