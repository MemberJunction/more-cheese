{
  "entity": "MJ: Credentials",
  "filePattern": "**/.*.json",
  "pull": {
    "filePattern": ".*.json",
    "createNewFileIfNotFound": true,
    "newFileName": ".credentials.json",
    "appendRecordsToExistingFile": true,
    "updateExistingRecords": true,
    "mergeStrategy": "merge",
    "excludeFields": ["__mj_CreatedAt", "__mj_UpdatedAt", "__mj_DeletedAt", "Values", "LastValidatedAt", "LastUsedAt"],
    "lookupFields": {
      "CredentialTypeID": { "entity": "MJ: Credential Types", "field": "Name" },
      "CategoryID": { "entity": "MJ: Credential Categories", "field": "Name" }
    },
    "ignoreVirtualFields": true
  }
}
