{
  "name": "more-cheese-demo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "MoreCheese demo open app for MemberJunction - the fictional International Cheese Federation association demo.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n[ERROR] Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "init": "node scripts/init-template.mjs",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-more-cheese-demo/*\"",
    "test": "turbo --log-order=stream test --filter=\"@mj-more-cheese-demo/*\"",
    "data:build": "loom build --project ./data",
    "data:accumulate": "loom accumulate --project ./data --prior-state ./metadata --weeks 1",
    "data:validate": "loom validate --project ./data --data ./metadata",
    "mj:migrate": "mj migrate --schema morecheese_members --dir ./migrations",
    "mj:codegen": "mj codegen",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema morecheese_members",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlueCypress/More-Cheese-Demo-V2"
  },
  "packageManager": "npm@10.5.0",
  "devDependencies": {
    "@angular/animations": "21.1.3",
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@angular/router": "21.1.3",
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.1.0-edge.4",
    "@memberjunction/core": "^6.1.0-edge.4",
    "@memberjunction/global": "^6.1.0-edge.4",
    "@memberjunction/ng-base-forms": "^6.1.0-edge.4",
    "@memberjunction/ng-entity-viewer": "^6.1.0-edge.4",
    "@memberjunction/ng-link-directives": "^6.1.0-edge.4",
    "@memberjunction/server": "^6.1.0-edge.4",
    "@types/node": "^22.10.0",
    "acorn": "^8.12.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
