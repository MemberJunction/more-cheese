{
  "name": "more-cheese-demo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "MoreCheese demo open app for MemberJunction - the fictional International Cheese Federation association demo.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n[ERROR] Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "init": "node scripts/init-template.mjs",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "generate": "node scripts/generate.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check:ownership": "node scripts/check-ownership.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "test": "turbo --log-order=stream test --filter=\"@mj-biz-apps/*\"",
    "validate:loom": "node scripts/validate-loom-data.mjs",
    "test:loom-mutations": "node scripts/test-loom-mutations.mjs",
    "check:sync-id-parity": "node scripts/check-sync-id-parity.mjs",
    "check:release-seed": "node scripts/check-release-seed-coverage.mjs",
    "check:seed-cadence": "node scripts/check-release-seed-cadence.mjs",
    "lint:distribution": "node scripts/check-distribution-seed.mjs",
    "lint:migrations": "node scripts/check-migration-order.mjs",
    "lint:peer-ranges": "node scripts/check-peer-ranges.mjs",
    "lint:release-pushes": "node scripts/check-release-pushes.mjs",
    "sync:app-version": "node scripts/sync-app-version.mjs",
    "release:plan": "node scripts/release-prep.mjs --plan",
    "test:gates": "node --test scripts/check-claude-md.spec.mjs scripts/check-peer-ranges.spec.mjs scripts/check-release-seed-cadence.spec.mjs scripts/check-release-seed-coverage.spec.mjs scripts/generate-teardown.spec.mjs scripts/validate-content.spec.mjs scripts/sync-app-version.spec.mjs scripts/check-release-pushes.spec.mjs scripts/release-plan.spec.mjs scripts/release-prep.spec.mjs",
    "generate:teardown": "node scripts/generate-teardown.mjs",
    "test:teardown": "node --test scripts/generate-teardown.spec.mjs",
    "mj:migrate": "mj migrate --schema morecheese_members --dir ./migrations",
    "mj:codegen": "mj codegen",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema morecheese_members",
    "change": "changeset",
    "version": "changeset version && npm run sync:app-version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/more-cheese"
  },
  "packageManager": "npm@10.5.0",
  "devDependencies": {
    "@angular/animations": "21.2.22",
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/router": "21.2.22",
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.1.2",
    "@memberjunction/core": "^6.1.2",
    "@memberjunction/global": "^6.1.2",
    "@memberjunction/ng-base-forms": "^6.1.2",
    "@memberjunction/ng-entity-viewer": "^6.1.2",
    "@memberjunction/ng-link-directives": "^6.1.2",
    "@memberjunction/server": "^6.1.2",
    "@types/node": "^22.10.0",
    "acorn": "^8.12.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "zod": "^3.25.76",
    "marked": "^17.0.6",
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
