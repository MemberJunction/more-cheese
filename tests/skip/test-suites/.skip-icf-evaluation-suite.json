{
  "fields": {
    "Name": "Skip ICF Evaluation Suite",
    "Description": "Skip evaluation on the More Cheese (International Cheese Federation) demo world: 31 Agent Eval tests across six tiers (simple, trends, cross-domain, advanced drill-down, edge cases, advanced visualization). Ported from the AssociationDB comprehensive suite and adapted to BizApps People/Orders/Committees/Forms/Issues/Tasks plus MoreCheese member, learning, competition and advocacy entities. Every test is judged (llm-judge 0.7) plus trace-no-errors (0.3). Run with: DB_DATABASE=<db> node packages/MJCLI/bin/run.js test suite --name \"Skip ICF Evaluation Suite\" from the MJ repo root.",
    "Status": "Active",
    "Tags": "[\"skip\",\"more-cheese\"]"
  },
